@model Core.ViewModels.ManagePrivateSessionsViewModel

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/sessions.js?v=20260920"></script>

<script>

    function validateScheduleTime() {
        const scheduledAtInput = document.getElementById("scheduledAt");
        const errorSpan = document.getElementById("scheduledAtError");
        if (!scheduledAtInput.value) {
            errorSpan.textContent = "Scheduled time is required.";
            return false;
        }

        // errorSpan.textContent = ""; // clear error if valid
        return true;
    }


     function updateMinutesDisplay() {
        const input = document.getElementById("scheduledHours");
        const display = document.getElementById("minutesDisplay");

        if (input && display) {
            const hoursValue = parseFloat(input.value);
            if (!isNaN(hoursValue)) {
                const totalMinutes = Math.round(hoursValue * 60);
                const hours = Math.floor(totalMinutes / 60);
                const minutes = totalMinutes % 60;

                let message = "(";
                if (hours > 0) {
                    message += hours + " hour" + (hours > 1 ? "s" : "");
                    if (minutes > 0) {
                        message += " ";
                    }
                }
                if (minutes > 0) {
                    message += minutes + " minute" + (minutes > 1 ? "s" : "");
                }
                message += ")";

                display.textContent = message;
            } else {
                display.textContent = "";
            }
         }
    }

    document.getElementById("scheduledHours").addEventListener("input", updateMinutesDisplay);

    // Optional: initialize on page load if there's a preset value
    window.addEventListener("DOMContentLoaded", updateMinutesDisplay);
</script>


@* @model IEnumerable<Core.ViewModels.SchedulesViewModel> *@
@{
    ViewData["Title"] = "Manage Private Course Sessions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int courseId = (int)ViewBag.CourseID;
    bool hasPrivateRegistrationAvailable = Model.PrivateRegistrationRemainingSessions.Values.Any(remaining => !remaining.HasValue || remaining.Value > 0);
    bool showAddSessionForm = hasPrivateRegistrationAvailable;
}


<h2>@ViewData["Title"]</h2>

<a href="/Course/List" class="participation-back-link" style="color: #000 !important;">Back to Courses List</a>



<div class="schedule-info">
    <strong>Course:</strong> @Model.Course.Title <br /><br />
    <strong>Duration:</strong> @Model.Course.Description <br /><br />
    <strong>Session Count:</strong> @Model.Course.SessionCount <br />
</div>

<p class="text-muted">Staff schedules the time and location for each participant. </p>

<!-- Add New Session Form -->
@if (showAddSessionForm)
{
    <div class="schedule-add-panel">
        <form method="post" asp-action="AddPrivateSession" asp-controller="Course" onsubmit="return validateScheduleTime()">
            <input type="hidden" name="courseId" value="@courseId" />
            @if (Model.Course.CourseType == "Private")
            {
                <div class="schedule-field"><strong>Participant:</strong><br />
                    <select name="enrollmentIdRef" required class="schedule-input">
                        <option value="">Select participant</option>
                        @foreach (var registration in Model.PrivateRegistrations)
                        {
                            var remaining = Model.PrivateRegistrationRemainingSessions.TryGetValue(registration.EnrollmentID, out var count) ? count : null;
                            if (!remaining.HasValue || remaining.Value > 0)
                            {
                                <option value="@registration.EnrollmentID" data-child="@registration.ChildID">@registration.Child?.Name (@registration.Status)@(remaining.HasValue ? $" — {remaining} session(s) remaining" : " — unlimited")</option>
                            }
                        }
                    </select>
                    <input type="hidden" name="childId" id="privateChildId" />
                </div>
                <script>document.querySelector('select[name=enrollmentIdRef]').addEventListener('change', function(){ document.getElementById('privateChildId').value=this.options[this.selectedIndex].dataset.child || ''; });</script>
            }
            <input type="hidden" name="courseId" value="@courseId" />


        <div class="schedule-field">
            <strong>Scheduled At:</strong><br />
            <input type="datetime-local" name="scheduledAt" id="scheduledAt" required class="schedule-input" />
            <span id="scheduledAtError" style="color: red; margin-left: 10px;"></span>
        </div>

        <div class="schedule-field">
            <strong>Event Time Zone:</strong><br />
            <select name="scheduledTimeZoneId" required class="schedule-input">
                @foreach (var zone in (IReadOnlyList<TimeZoneOption>)ViewBag.TimeZones)
                {
                    <option value="@zone.Id" selected="@(zone.Id == (string)ViewBag.UserTimeZoneId)">@zone.DisplayName (@zone.Id)</option>
                }
            </select>
        </div>
       
        <div class="schedule-field">
            <strong>Scheduled Hours:</strong><br />
            <input type="number" step="0.25" min="0.5" name="scheduledHours" id="scheduledHours" required onchange="return updateMinutesDisplay()" class="schedule-input" />
            <span id="minutesDisplay" style="margin-left: 10px; font-style: italic;"></span>
        </div>

        <div class="schedule-field">
            <strong>Repeat:</strong><br />
            <select id="repeatType" name="repeatType" class="schedule-input">
                <option value="None">Does not repeat</option>
                <option value="Daily">Daily</option>
                <option value="Weekly">Weekly</option>
            </select>
        </div>

        <div class="schedule-field">
            <strong>Repeat Count:</strong><br />
            <input type="number" name="repeatCount" min="1" max="100" value="1" class="schedule-input" />
            <span style="font-style: italic;"></span>
        </div>

        <div class="schedule-field">
            <strong>Location:</strong><br />
            <input type="text"  name="location" required class="schedule-input" />
        </div>

        <div class="schedule-field">
            <strong>Staff Note:</strong><br />
            <textarea name="staffNote" rows="3" class="schedule-input" ></textarea>
        </div>



            <button type="submit" class="management-form__save">Add Session(s)</button>
        </form>
    </div>
}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success schedule-alert">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger schedule-alert">@TempData["ErrorMessage"]</div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning schedule-alert">@TempData["WarningMessage"]</div>
}

<!-- Existing Sessions Table -->
<h5 class="schedule-section-title">Upcoming Sessions</h5>

<div class="management-table-wrapper"><table class="management-table">
    <thead>
        <tr style="background-color: #f2f2f2;">


            <th data-sort-column="participant" onclick="sortPrivateSessions('participant')" style="padding: 8px; border: 1px solid #ddd; width: 15%; cursor: pointer;">Participant <span class="sort-indicator">↕</span></th>
            <th data-sort-column="date" onclick="sortPrivateSessions('date')" style="padding: 8px; border: 1px solid #ddd; width: 10%; cursor: pointer;">Date <span class="sort-indicator">↕</span></th>
            <th style="padding: 8px; border: 1px solid #ddd; width: 10%">Start Time</th>
            <th style="padding: 8px; border: 1px solid #ddd; width: 10%">End Time</th>

            <th style="padding: 8px; border: 1px solid #ddd; width: 25%">Location</th>
            <th style="padding: 8px; border: 1px solid #ddd; width: 10%">Status</th>
            <th style="padding: 8px; border: 1px solid #ddd; width: 25%">Staff Note</th>
            <th class="action-column" style="padding: 8px; border: 1px solid #ddd; width: 10%">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.PrivateSessions.Any())
        {
            foreach (var s in Model.PrivateSessions)
            {
                <tr id="row-@s.EnrollmentID">
                   @*  <td style="padding: 8px; border: 1px solid #ddd;">@s.ScheduledAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@s.ScheduledHours</td> *@

                    @{
                        var scheduledAt = s.ScheduledAt.ToUserTime(User, AppTimeZoneService);
                        var scheduledHours = @s.ScheduledHours.HasValue ? (double)@s.ScheduledHours.Value : 0;
                        DateTime? endTime = scheduledAt?.AddHours(scheduledHours);
                    }

                    <td data-sort-value="@(s.Child?.Name ?? string.Empty)" style="padding: 8px; border: 1px solid #ddd;">
                        @(s.Child?.Name ?? "—")
                    </td>
                    <td data-sort-value="@(s.ScheduledAt?.ToString("yyyyMMddHHmmss") ?? string.Empty)" style="padding: 8px; border: 1px solid #ddd;">
                        @(scheduledAt.HasValue? scheduledAt.Value.ToString("yyyy-MM-dd") : "")
                    </td>
                    <td style="padding: 8px; border: 1px solid #ddd;">
                        @(scheduledAt.HasValue? scheduledAt.Value.ToString("HH:mm") : "")
                    </td>
                    <td style="padding: 8px; border: 1px solid #ddd;">
                        @(endTime.HasValue? endTime.Value.ToString("HH:mm") : "")
                    </td>



                    <td style="padding: 8px; border: 1px solid #ddd;">@s.Location</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@s.Status</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@s.StaffNote</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">
                        @if (s.Status == "Canceled")
                        {
                            <span style="color:#6c757d; font-style:italic;">Resolved during cancellation</span>
                        }
                        @if (!(s.Status == "Canceled") && !(s.Status == "Completed"))
                        {
                            <a href="#" onclick="loadEditSessionForm(@s.EnrollmentID); return false;" style="margin-left: 10px; color: #007bff; text-decoration: none;">Edit</a>
                        }

                        <a href="#" onclick="loadDeleteSessionConfirm(@s.EnrollmentID)" style="margin-left: 10px; color: #007bff; text-decoration: none;">Delete</a>
                    </td>
                </tr>
            }
        }

      


        else
        {
            <tr>
                <td colspan="8" style="text-align: center; padding: 10px;">No sessions scheduled yet.</td>
            </tr>
        }
    </tbody>
</table></div>

<script>
    const privateSessionSortDirections = { participant: 1, date: 1 };

    function sortPrivateSessions(column) {
        const table = document.querySelector('.management-table');
        const body = table?.querySelector('tbody');
        if (!body) return;

        const rows = Array.from(body.querySelectorAll('tr')).filter(row => row.id.startsWith('row-'));
        const direction = privateSessionSortDirections[column];
        const columnIndex = column === 'participant' ? 0 : 1;

        rows.sort((a, b) => {
            const aValue = a.children[columnIndex]?.dataset.sortValue?.toLowerCase() ?? '';
            const bValue = b.children[columnIndex]?.dataset.sortValue?.toLowerCase() ?? '';
            return aValue.localeCompare(bValue, undefined, { numeric: true }) * direction;
        });

        rows.forEach(row => body.appendChild(row));
        privateSessionSortDirections[column] *= -1;
    }
</script>




<!-- Modal Popup -->
<div id="sessionModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Course Session</h5>
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- The Add/Edit form will be loaded here dynamically -->
                <!-- The Delete Confirm popup will be loaded here dynamically -->
            </div>
        </div>
    </div>
</div>




