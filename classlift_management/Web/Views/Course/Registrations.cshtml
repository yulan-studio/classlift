@model Core.ViewModels.CourseRegistrationsViewModel

@{
    ViewData["Title"] = "Course Registrations";
}

<h2>Course Registrations</h2>

<p><strong>Course:</strong> @Model.CourseTitle</p>

<a asp-action="List" class="participation-back-link">Back to Courses</a>

<div style="border-top: 2px solid #ddd; margin: 20px 0;"></div>

<table class="table table-bordered" style="max-width: 700px;">
    <thead class="table-primary">
        <tr>
            <th>#</th>
            <th>@CurrentTenant.Terminology.ParticipantSingular</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Students.Any())
        {
            for (var index = 0; index < Model.Students.Count; index++)
            {
                var student = Model.Students[index];
                <tr>
                    <td>@(index + 1)</td>
                    <td>
                        <a href="/Child/MoreInfo/@student.ChildID">@student.Name</a>
                    </td>
                    <td>@student.Status</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">No registered @CurrentTenant.Terminology.ParticipantPlural.ToLowerInvariant().</td>
            </tr>
        }
    </tbody>
</table>
