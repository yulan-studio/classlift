

@* @model IEnumerable<Core.ViewModels.CourseViewModel>  *@

@model X.PagedList.IPagedList<Core.ViewModels.CourseViewModel>
@using X.PagedList.Mvc.Core
@using X.PagedList



@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Manage Courses";
}

<h1>@ViewData["Title"]</h1>


<a href="/Course/Add" class="list-add-link">Add Course</a>

<form method="get" asp-action="List" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
    <div class="col-md-3">
        <label for="specialtyId" class="form-label">Specialty</label>
        <select id="specialtyId" name="specialtyId" class="form-select" asp-items="ViewBag.SpecialtyFilterOptions">
            <option value="">All specialties</option>
        </select>
    </div>
    <div class="col-md-3">
        <label for="coachId" class="form-label">@CurrentTenant.Terminology.ProviderSingular</label>
        <select id="coachId" name="coachId" class="form-select" asp-items="ViewBag.CoachFilterOptions">
            <option value="">All @CurrentTenant.Terminology.ProviderPlural.ToLowerInvariant()</option>
        </select>
    </div>
    <div class="col-md-2">
        <label for="courseType" class="form-label">Course Type</label>
        <select id="courseType" name="courseType" class="form-select" asp-items="ViewBag.CourseTypeFilterOptions">
            <option value="">All types</option>
        </select>
    </div>
    <div class="col-md-2">
        <label for="isActive" class="form-label">Is Active</label>
        <select id="isActive" name="isActive" class="form-select" asp-items="ViewBag.ActiveFilterOptions">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="list-filter__search">Search</button>
        <a href="/Course/List" class="list-filter__reset">Reset</a>
    </div>
</form>

<div class="management-table-wrapper">
<table class="management-table">
    <thead>
        <tr>
            <th style="width: 3%">#</th>
            <th class="sortable-header" style="width: 10%">
                
                <a asp-action="List" asp-route-sortOrder="@ViewData["SpecialtySortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]">
                    Specialty
                    @if ((string)ViewData["CurrentSort"] == "specialty")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "specialty_desc")
                    {

                        <span>▼</span>
                    }
                </a>


            </th>
            <th class="sortable-header" style="width: 5%">
                <a asp-action="List" asp-route-sortOrder="@ViewData["CoachSortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]">
                    @CurrentTenant.Terminology.ProviderSingular
                    @if ((string)ViewData["CurrentSort"] == "coach")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "coach_desc")
                    {

                        <span>▼</span>
                    }
                </a>
                </th>
            <th class="sortable-header">
                <a asp-action="List" asp-route-sortOrder="@ViewData["TitleSortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]">
                    Title
                    @if ((string)ViewData["CurrentSort"] == "title")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "title_desc")
                    {

                        <span>▼</span>
                    }
                </a>
            </th>
            
           
           @*  <th style="padding: 8px; border: 1px solid #ddd; width: 20%">Description</th> *@
            <th class="sortable-header" style="width: 7%">
                <a asp-action="List" asp-route-sortOrder="@ViewData["TypeSortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]" style="color: black; text-decoration: none; ">
                    Type
                    @if ((string)ViewData["CurrentSort"] == "type")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "type_desc")
                    {
                        <span>▼</span>
                    }
                </a>
            </th>
            <th class="sortable-header" style="width: 2%">
                <a asp-action="List" asp-route-sortOrder="@ViewData["SessionCountSortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]" style="color: black; text-decoration: none;">
                    Session Count
                    @if ((string)ViewData["CurrentSort"] == "session_count")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "session_count_desc")
                    {
                        <span>▼</span>
                    }
                </a>
            </th>
            <th class="sortable-header" style="width: 5%">
                <a asp-action="List" asp-route-sortOrder="@ViewData["MaxCapacitySortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]" style="color: black; text-decoration: none;">
                    Max Capacity
                    @if ((string)ViewData["CurrentSort"] == "max_capacity")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "max_capacity_desc")
                    {
                        <span>▼</span>
                    }
                </a>
            </th>
            
            @* <th style="padding: 8px; border: 1px solid #ddd; width: 5%; background-color: lightblue;">
                <a asp-action="List" asp-route-sortOrder="@ViewData["HourlyCostSortParm"]" style="color: black; text-decoration: none;">
                    Hourly Cost
                    @if ((string)ViewData["CurrentSort"] == "hourly_cost")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "hourly_cost_desc")
                    {
                        <span>▼</span>
                    }
                </a>
            </th> *@
 
            <th class="sortable-header">
                <a asp-action="List" asp-route-sortOrder="@ViewData["RegistrationsSortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]" style="color: black; text-decoration: none;">
                    # of Registrations
                    @if ((string)ViewData["CurrentSort"] == "registrations")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "registrations_desc")
                    {
                        <span>▼</span>
                    }
                </a>
            </th>
            <th class="sortable-header" style="width: 5%">
                <a asp-action="List" asp-route-sortOrder="@ViewData["IsActiveSortParm"]" asp-route-specialtyId="@ViewData["SpecialtyId"]" asp-route-coachId="@ViewData["CoachId"]" asp-route-courseType="@ViewData["CourseType"]" asp-route-isActive="@ViewData["IsActive"]" style="color: black; text-decoration: none;">
                    Is Active
                    @if ((string)ViewData["CurrentSort"] == "is_active")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CurrentSort"] == "is_active_desc")
                    {
                        <span>▼</span>
                    }
                </a>
            </th>
            <th style="width: 15%">Actions</th>
            <th style="width: 5%">Group Sessions</th>
        </tr>
    </thead>
    <tbody>
      @{
            int index = ((Model.PageNumber - 1) * Model.PageSize) + 1;
            foreach (var course in Model)
            {
                <tr>
                    <td>@index</td>
                    <td>@course.SpecialtyName</td>
                    <td>@course.CoachName</td>
                    <td>@course.Title</td>
                    @*   <td style="padding: 8px; border: 1px solid #ddd;">@course.Description</td>*@
                    <th>@course.CourseType</th>
                    <th>@course.SessionCount</th>
                    <th>@course.MaxCapacity</th>
                    @*  <td style="padding: 8px; border: 1px solid #ddd;">@course.HourlyCost</td>*@
        
                    <td>
                        <a asp-action="Registrations" asp-route-courseId="@course.CourseID">
                            @course.RegisteredChildrenCount
                        </a>
                    </td>
                    <td>@course.IsActive</td>
                    <td>
                       
                      @*   <a href="/Course/View/@course.CourseID" style="margin-left: 10px; color: #007bff; text-decoration: none;">View</a> *@
                        <a class="action-link" href="/Course/ConfirmDelete/@course.CourseID" style="@(course.RegisteredChildrenCount == 0 ?"":"display: none;")">Delete</a>
                        <a class="action-link" href="/Course/Edit/@course.CourseID">Edit</a>
                    </td>
                    <td>

                        @*   <a href="/Course/View/@course.CourseID" style="margin-left: 10px; color: #007bff; text-decoration: none;">View</a> *@
                        <a class="action-link" href="/Course/ManageSessions/@course.CourseID" style="@(course.CourseType == "Group" ?"":"display: none;")">Manage</a>

                    </td>
                </tr>
                index++;
            }
        }
        @if (!Model.Any())
        {
            <tr>
                <td colspan="11" class="text-center p-3">No courses match the selected filters.</td>
            </tr>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <tr>
                <td colspan="11">
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                </td>
            </tr>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <tr>
                <td colspan="11">
                    <div class="alert alert-danger">
                        @TempData["ErrorMessage"]
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>


<div class="list-pagination">
    @Html.PagedListPager(
    Model,
    page => Url.Action("List", new
    {
        page,
        sortOrder = ViewData["CurrentSort"],
        specialtyId = ViewData["SpecialtyId"],
        coachId = ViewData["CoachId"],
        courseType = ViewData["CourseType"],
        isActive = ViewData["IsActive"]
    }),
        new PagedListRenderOptions
        {
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            UlElementClasses = new[] { "pagination" },
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" }
        })
</div>





