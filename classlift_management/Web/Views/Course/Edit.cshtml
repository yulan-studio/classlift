@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "Edit Course";
}

@model Core.Models.Course



<h2>Edit Course</h2>
<div style="padding-top: 20px;">
  
</div>

<style>
    .edit-course-form-table {
        border-collapse: collapse;
        width: 100%;
        max-width: 600px;
        text-align: left;
    }

    .edit-course-form-table {
        display: table;
    }

    .edit-course-form-table tbody { display: table-row-group; }
    .edit-course-form-table tr { display: table-row; }
    .edit-course-form-table td { display: table-cell; }
    .edit-course-form-table td:first-child { width: 25%; }
    .edit-course-form-table td:nth-child(2) { width: 75%; }
    .edit-course-form-table input[type="text"],
    .edit-course-form-table input[type="number"] {
        width: 100% !important;
        max-width: 300px;
        min-height: 42px;
        box-sizing: border-box;
    }

    .edit-course-form-table input[type="checkbox"] {
        width: auto !important;
        min-height: 0;
    }

    .edit-course-form-table td[colspan="2"] { padding-top: 16px !important; }
    .edit-course-form-table .management-form__save,
    .edit-course-form-table .management-form__cancel {
        display: inline-block;
        min-height: 42px;
        box-sizing: border-box;
        padding: 10px 16px;
    }

    @@media (max-width: 767px) {
        .edit-course-form-table,
        .edit-course-form-table tbody,
        .edit-course-form-table tr,
        .edit-course-form-table td {
            display: block;
            width: 100%;
        }

        .edit-course-form-table tr { margin-bottom: 12px; }
        .edit-course-form-table td { padding: 4px 0 !important; }
        .edit-course-form-table td:first-child { padding-bottom: 0 !important; }

        .edit-course-form-table input[type="text"],
        .edit-course-form-table input[type="number"] {
            max-width: none;
        }
    }
</style>

<form asp-action="Edit" method="post">
    <input type="hidden" name="courseId" value="@Model.CourseID" />

    <table class="edit-course-form-table">
        <tr>
            <td style="padding: 8px;"><label for="name">Coach:</label></td>
           @*  <td style="padding: 8px;"><input type="text" name="name" value="@Model.Coach.Name" placeholder="Name" style="width: 60%;" readonly /><label>   Not to change</label></td> *@
           <td style="padding: 8px;">@Model.Coach?.Name</td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="title">Title:</label></td>
            <td style="padding: 8px;"><input class="classlift-control" type="text" name="title" value="@Model.Title" placeholder="Title" /></td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="description">Description:</label></td>
            <td style="padding: 8px;"><input class="classlift-control" type="text" name="description" value="@Model.Description" placeholder="Description" /></td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="CourseType">Course Type:</label></td>
            <input type="hidden" name="courseType" value="@Model.CourseType" />
            <td style="padding: 8px;">@Model.CourseType</td>
            
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="MaxCapacity">Max Capacity:</label></td>
            <td style="padding: 8px;">
                <input class="classlift-control" id="MaxCapacity" name="MaxCapacity" value="@(Model.MaxCapacity)" type="number" step="1" min="2" placeholder="Enter Max Capacity" @(Model.CourseType == "Private" ? "disabled" : "") />
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="SessionCount">Session Count:</label></td>
           @*  <td style="padding: 8px;"><input id="SessionCount" name="SessionCount" value="@(Model.SessionCount)" type="number" step="1" min="1" placeholder="Enter Session Count" style="width: 100%;"  /> </td> *@
            <input type="hidden" name="SessionCount" value="@Model.SessionCount" />
            <td style="padding: 8px;">@Model.SessionCount</td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="hourlyCost">Hourly Cost:</label></td>
            @* <td style="padding: 8px;"><input type="text" name="hourlyCost" value="@Model.HourlyCost" placeholder="HourlyCost" style="width: 60%;" readonly /></td> *@
            <input type="hidden" name="hourlyCost" value="@Model.HourlyCost" />
            <td style="padding: 8px;">@Model.HourlyCost</td>
           
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="sessionCost">Session Cost:</label></td>
            <input type="hidden" name="sessionCost" value="@Model.SessionCost" />
            <td style="padding: 8px;">@Model.SessionCost</td>
        </tr>

         <tr>
           @*  <td style="padding: 8px;"><label for="isActive">Is Active:</label></td>
            <td style="padding: 8px;"> <input id="isActive" name="isActive" type="checkbox" value="@Model.IsActive" /> </td> *@
            <td style="padding: 8px;"><label for="isActive">Is Active:</label></td> 
            <td style="padding: 8px;"> <input class="classlift-checkbox" asp-for="IsActive" type="checkbox" /></td>
            
            <input type="hidden" asp-for="IsActive" value="false" />
        </tr> 
      
        <tr>
            <td colspan="2" style="text-align: left; padding: 20px 16px 16px 8px;">
                <button type="submit" class="management-form__save">Save</button>
                <a href="/Course/List" class="management-form__cancel">Cancel</a>
        </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: left; padding: 20px 16px 16px 8px;">
             

                @if (!ViewData.ModelState.IsValid)
                {
                    foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div class="alert alert-danger">
                            @error.ErrorMessage
                        </div>
                    }
                }
             </td>
        </tr>
    </table>

   
</form>


@* @section Scripts {
    <partial name="_ValidationScriptsPartial" />
    } *@
