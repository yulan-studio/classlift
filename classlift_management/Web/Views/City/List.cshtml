*@
@* @model IEnumerable<City> *@

@model Core.ViewModels.ManageCitiesViewModel

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/cities.js" asp-append-version="true"></script>




<h1 class="management-page-title">Manage Cities</h1>

<a href="#" onclick="loadAddProvinceForm(); return false;" class="list-add-link" style="margin-right: 20px;">Add Province</a>
<a href="#" onclick="loadAddForm(); return false;" class="list-add-link">Add City</a>

<div class="management-table-wrapper">
<table class="management-table" style="width: 50%;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th class="sortable-header">
                <a class="sortable-link" asp-action="List" asp-route-sortOrder="@ViewData["ProvinceNameParm"]">
                    Province Name
                    @if ((string)ViewData["ProvinceNameParm"] == "province")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["ProvinceNameParm"] == "province_desc")
                    {
                        <span>▼</span>
                    }
                </a>
            </th>
            <th class="sortable-header">
                <a class="sortable-link" asp-action="List" asp-route-sortOrder="@ViewData["CityNameParm"]">
                    City Name
                    @if ((string)ViewData["CityNameParm"] == "name")
                    {
                        <span>▲</span>
                    }
                    else if ((string)ViewData["CityNameParm"] == "name_desc")
                    {

                        <span>▼</span>
                    }
                </a>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @{
        foreach (var city in Model.Cities)
        {
            <tr id="row-@city.CityID">
                <td>@(city.Province?.Name ?? "Not assigned")</td>
                <td>@city.Name</td>
                <td>
                    <a href="#" class="action-link" onclick="loadEditForm(@city.CityID)">Edit</a>
                    
                    @if (!Model.UsedCityIds.Contains(city.CityID))
                    {
                        <a href="#" class="action-link" onclick="loadDeleteCityConfirm(@city.CityID)">Delete</a>
                    }
                </td>
            </tr>
        }
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <tr>
                <td colspan="3">
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                </td>
            </tr>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <tr>
                <td colspan="3">
                    <div class="alert alert-danger">
                        @TempData["ErrorMessage"]
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- Modal Popup -->
<div id="cityModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">City</h5>
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- The Add/Edit form will be loaded here dynamically -->
                <!-- The Delete Confirm popup will be loaded here dynamically -->
            </div>
        </div>
    </div>
</div>

