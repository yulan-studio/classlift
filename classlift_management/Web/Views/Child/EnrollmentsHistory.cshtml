@model Core.ViewModels.EnrollmentsHistoryViewModel

@{
    Layout = null;
}

<h3>Enrollments History</h3>

@* <div style="padding-top: 20px">
    <p><strong>Name:</strong> @Model.Child.Name</p>
    <p><strong>Birth Date:</strong> @(Model.Child.BirthDate.HasValue ? Model.Child.BirthDate.Value.ToString("yyyy-MM-dd") : "N/A")</p>
    <p><strong>Gender:</strong> @Model.Child.Gender</p>
    <p><strong>City:</strong> @(Model.Child.City != null ? Model.Child.City.Name : "N/A")</p>
</div>
<a href="/Child/List" class="participation-back-link">Back to @CurrentTenant.Terminology.ParticipantPlural List</a>
<div style="border-top: 2px solid #ddd; margin: 30px 0;"></div> *@

<div style="padding-top: 20px; padding-bottom: 20px">
    <h4 style="color:steelblue">- Courses -</h4>
</div>

<table id="CompletedCourses" style="border-collapse: collapse; width: 100%; text-align: left;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th style="padding: 8px; border: 1px solid #ddd;">Course</th>
            <th style="padding: 8px; border: 1px solid #ddd;">@CurrentTenant.Terminology.ProviderSingular</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Scheduled At</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Scheduled Hours</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Actual Hours</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Hourly Cost</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Status</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CompletedCourses!=null && Model.CompletedCourses.Any())
        {
            foreach (var enrollment in Model.CompletedCourses)
            {
                <tr>
                    <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Course.Title</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@(enrollment.Course.Coach?.Name ?? "N/A")</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@(enrollment.ScheduledAt.ToUserTime(User, AppTimeZoneService)?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.ScheduledHours</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.ActualHours</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Course.HourlyCost</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">
                        @if (enrollment.Status == "Completed" && !string.IsNullOrWhiteSpace(enrollment.CoachNote))
                        {
                            <a href="#"
                               class="coach-note-link"
                               data-coach-note="@enrollment.CoachNote"
                               onclick="openCoachNotePopup(this); return false;"
                               style="color: #007bff; text-decoration: underline;">
                                @enrollment.Status
                            </a>
                        }
                        else
                        {
                            @enrollment.Status
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" style="text-align: center; padding: 10px;">No completed courses.</td>
            </tr>
        }

       
    </tbody>
</table>

<div id="coachNotePopup" class="coach-note-popup" role="dialog" aria-modal="true" aria-labelledby="coachNotePopupTitle" style="display: none;">
    <div class="coach-note-popup__content">
        <button type="button" class="coach-note-popup__close" onclick="closeCoachNotePopup()" aria-label="Close">&times;</button>
        <h4 id="coachNotePopupTitle">@CurrentTenant.Terminology.ProviderSingular Note</h4>
        <div id="coachNotePopupText" class="coach-note-popup__text"></div>
    </div>
</div>

<style>
    .coach-note-popup {
        position: fixed;
        inset: 0;
        z-index: 1050;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .coach-note-popup__content {
        position: relative;
        width: min(600px, 100%);
        max-height: 80vh;
        overflow-y: auto;
        padding: 24px;
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.25);
    }

    .coach-note-popup__close {
        position: absolute;
        top: 8px;
        right: 12px;
        border: 0;
        background: transparent;
        font-size: 28px;
        line-height: 1;
        cursor: pointer;
    }

    .coach-note-popup__text {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }
</style>

<script>
    function openCoachNotePopup(link) {
        document.getElementById('coachNotePopupText').textContent = link.dataset.coachNote || 'No Coach Note available.';
        document.getElementById('coachNotePopup').style.display = 'flex';
    }

    function closeCoachNotePopup() {
        document.getElementById('coachNotePopup').style.display = 'none';
    }

    document.getElementById('coachNotePopup')?.addEventListener('click', function (event) {
        if (event.target === this) {
            closeCoachNotePopup();
        }
    });
</script>


<div style="padding-top: 20px; padding-bottom: 20px">
    <h4 style="color:steelblue">- Activities -</h4>
</div>

<table id="CompletedActivities" style="border-collapse: collapse; width: 100%; text-align: left;">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th style="padding: 8px; border: 1px solid #ddd;">Activity</th>
            
            <th style="padding: 8px; border: 1px solid #ddd;">Scheduled At</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Cost</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CompletedActivities!=null && Model.CompletedActivities.Any())
           
        {
            foreach (var enrollment in Model.CompletedActivities)
            {
                <tr>
                    <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Activity.Title</td>
               
                    <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Activity.ScheduledAt.ToUserTime(User, AppTimeZoneService).ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="padding: 8px; border: 1px solid #ddd;">@* @enrollment.Activity.Cost *@</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" style="text-align: center; padding: 10px;">No completed activities.</td>
            </tr>
        }


    </tbody>
</table>



