


@* <script src="/js/registrations.js"></script> *@
@model Core.ViewModels.ManageRegisterationsViewModel
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<style>
    .registrations-page { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
    .registrations-page-header { margin-bottom: 1.5rem; }
    .registrations-page-header h2 { margin: 0; color: #152238; font-size: clamp(1.6rem, 2.5vw, 2rem); font-weight: 700; }
    .registrations-page-header p { margin: .35rem 0 0; color: #6b778c; font-size: .95rem; }
    .registration-section-title { margin: 1.5rem 0 .85rem; color: #1b7bab; font-size: 1.25rem; font-weight: 700; }
    .registration-notice { margin-bottom: 1rem; padding: .85rem 1rem; border: 1px solid #d6e2e7; border-radius: 7px; background: #f8f9fa; color: #526176; }
    .registration-notice a { color: #1b7bab; font-weight: 600; }
    .registrations-table-wrapper table { min-width: 760px; margin: 0; }
    .registrations-table-wrapper thead th { white-space: nowrap; }
    .registrations-page .empty-row { padding: 1rem; color: #6b778c; background: #f9fbfd; }
    /* ===== Desktop default ===== */
    table.mobile-stack {
        width: 100%;
        border-collapse: collapse;
    }

        table.mobile-stack th,
        table.mobile-stack td {
            padding: 8px;
            border: 1px solid #ddd;
            vertical-align: top;
        }






    .registrations-table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* ===== Mobile table layout ===== */
    @@media (max-width: 767px) {
        .registrations-table-wrapper {
            overflow-x: scroll;
        }

        table.mobile-stack {
            min-width: 760px;
        }
    }
</style>




<div class="registrations-page">
<div class="registrations-page-header">
    <h2>Registration History</h2>
    <p>Review your registered courses and activities.</p>
</div>




<!-- ✅ Table Showing Already Registered Courses -->
<h4 class="registration-section-title">Courses</h4>
<div class="registration-notice">
    Please go to the <a href="/Child/MyConfirmations">Confirmations</a> to confirm the courses you have registered for. To view upcoming course session schedules, please check the <a href="/Child/MySchedules">Schedules</a> section.
</div>
<div class="registrations-table-wrapper">
<table class="management-table mobile-stack table table-bordered mt-3" @* class="mobile-stack" *@>
    <thead class="management-table-header">
        <tr>
            <th>Course</th>
            <th>Status</th>
            <th>Is Paid</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CourseEnrollments.Any())
        {

            foreach (var enrollment in Model.CourseEnrollments)

            {
                <tr>
                    <td class="course-title" data-label="Course">@enrollment.Title</td>
                    <td data-label="Status">@enrollment.Status</td>
                    <td data-label="Is Paid">
                        @if (!enrollment.IsPaid)
                        {
                            <a href="javascript:void(0);" onclick="showPaymentModal('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(enrollment.PaymentDescription))')">
                                False
                            </a>
                        }
                        else
                        {
                            @enrollment.IsPaid
                        }
                    </td>


                 
                </tr>
            }
           
        }
        else
        {
            <tr>
                <td colspan="3" class="empty-row text-center">No courses enrolled.</td>
            </tr>
        }


        
    </tbody>
</table>
</div>









<!-- ✅ Table Showing Already Enrolled Activities -->
<h4 class="registration-section-title">Activities</h4>
<div class="registration-notice">
    Please go to the <a href="/Child/MyConfirmations">Confirmations</a> to confirm the activities you have registered for. For upcoming activities, please check the <a href="/Child/MySchedules">Schedules</a> section.
</div>
<div class="registrations-table-wrapper">
<table class="management-table mobile-stack table table-bordered mt-3" @* class="mobile-stack" *@>
 

    <thead class="management-table-header">
        <tr>
            <th>Activity</th>
            <th>Description</th>
            <th>Address</th>
            <th>Scheduled At</th>
            <th>Status</th>
            <th>Is Paid</th>
          
        </tr>
    </thead>
       
    <tbody>
        @if (Model.ActivityEnrollments.Any())
        {
            foreach (var enrollment in Model.ActivityEnrollments)
            {
                <tr>
                    <td data-label="Activity">@enrollment.Title</td>
                    <td data-label="Description">@enrollment.Description</td>
                    <td data-label="Address">@enrollment.Address</td>
                    <td data-label="Scheduled At">@enrollment.ScheduledAt.ToUserTime(User, AppTimeZoneService).ToString("yyyy-MM-dd HH:mm")</td>
                    <td data-label="Status">@enrollment.Status</td>
                    <td data-label="Is Paid">
                        @if (!enrollment.IsPaid)
                        {
                            <a href="javascript:void(0);" onclick="showPaymentModal('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(enrollment.PaymentDescription))')">
                                False
                            </a>
                        }
                        else
                        {
                            @enrollment.IsPaid
                        }
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="empty-row text-center">No activities enrolled.</td>
            </tr>
        }

      
    </tbody>
</table>
</div>





<!-- Bootstrap Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">Payment Description</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="paymentModalBody">
                <!-- Content will be filled dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-..." crossorigin="anonymous"></script>
<script>
    function showPaymentModal(description) {

        var modalBody = document.getElementById('paymentModalBody');
        modalBody.textContent = description;

        var modal = new bootstrap.Modal(document.getElementById('paymentModal'));
        modal.show();
    }
</script>

</div>





     


