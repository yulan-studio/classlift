@model Core.ViewModels.ChildSchedulesViewModel


@* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@

<style>
    .schedules-page { max-width: 1080px; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
    .schedules-page-header { margin-bottom: 1.5rem; }
    .schedules-page-header h2 { margin: 0; color: #152238; font-size: clamp(1.6rem, 2.5vw, 2rem); font-weight: 700; }
    .schedules-page-header p { margin: .35rem 0 0; color: #6b778c; font-size: .95rem; }
    .schedule-section-title { margin: 1.5rem 0 .85rem; color: #1b7bab; font-size: 1.25rem; font-weight: 700; }
    .schedule-card { margin-bottom: 1rem; border: 1px solid #e5eaf0; border-radius: 12px; background: #fff; box-shadow: 0 3px 12px rgba(24, 47, 76, .06); overflow: hidden; }
    .schedule-summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.15rem; }
    .schedule-summary h5 { margin: 0 0 .45rem; color: #152238; font-size: 1.05rem; font-weight: 650; }
    .schedule-description { margin: 0 0 .5rem; color: #65748b; font-size: .9rem; }
    .schedule-meta { display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; color: #65748b; font-size: .9rem; }
    .schedule-meta strong { color: #26364d; font-weight: 600; }
    .schedule-status-summary { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .7rem; }
    .schedule-status-badge { display: inline-flex; align-items: center; gap: .25rem; padding: .25rem .5rem; border-radius: 999px; color: #526176; background: #f1f5f8; font-size: .78rem; }
    .schedule-status-badge strong { color: #26364d; }
    .schedule-status-badge strong[class^="status-"] { display: inline-flex; min-width: 1.35rem; justify-content: center; padding: .08rem .35rem; border-radius: 999px; font-size: .9rem; font-weight: 800; }
    .schedule-status-badge .status-scheduled { color: #146c43; background: #d1e7dd; }
    .schedule-status-badge .status-canceled { color: #b02a37; background: #f8d7da; }
    .schedule-status-badge .status-deleted { color: #b02a37; background: #f8d7da; }
    .schedule-status-badge .status-request { color: #9a5b00; background: #ffe5b4; }
    .schedule-toggle { flex: 0 0 auto; border: 1px solid #d6e4f2; border-radius: 7px; padding: .5rem .75rem; color: #2673ad; background: #f1f7fc; font-size: .85rem; }
    .schedule-toggle:hover, .schedule-toggle:focus { color: #185681; background: #e5f1fa; border-color: #b9d5eb; }
    .schedule-details { border-top: 1px solid #e5eaf0; padding: 0 1.15rem 1.15rem; }
    .schedule-table-wrapper { width: 100%; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .schedule-table-wrapper table { min-width: 760px; }
    .schedule-details .card-body { padding: 0; }
    .empty-schedules { border: 1px dashed #ccd6e2; border-radius: 10px; color: #6b778c; background: #f9fbfd; }

    @@media (max-width: 768px) {
        .btn-save {
            width: 100%;
        }

        .schedules-page { padding: 1rem .75rem 2rem; }
        .schedule-summary { align-items: flex-start; flex-direction: column; }
        .schedule-toggle { width: 100%; }
    }
</style>

<div class="schedules-page">
<div class="schedules-page-header">
    <h2>Upcoming Schedules</h2>
    <p>View and manage your upcoming course sessions.</p>
</div>

<h4 class="schedule-section-title">Courses</h4>

@if (Model.CoursesSchedules.Any())
{
    //var now = DateTime.UtcNow;

    @foreach (var courseSchedules in Model.CoursesSchedules)
    {
        var scheduledCount = courseSchedules.Schedules.Count(s => s.Status == "Scheduled");
        var canceledCount = courseSchedules.Schedules.Count(s => s.Status == "Canceled");
        var deletedCount = courseSchedules.Schedules.Count(s => s.Status == "Deleted");
        var onLeaveCount = courseSchedules.Schedules.Count(s => s.Status == "OnLeave");
        var requestToLeaveCount = courseSchedules.Schedules.Count(s => s.Status == "RequestToLeave");
        var requestToRescheduleCount = courseSchedules.Schedules.Count(s => s.Status == "RequestToReschedule");
        @* <div style="padding: 10px 20px 10px 20px; margin: 20px 0px 20px 0px; border: 1px solid #ddd; background-color: #f8f9fa;">
 *@
        <section class="schedule-card">
        <div class="schedule-summary">
            <div>
                <h5>@courseSchedules.Course.Title</h5>
                @if (!string.IsNullOrWhiteSpace(courseSchedules.Course.Description))
                {
                    <p class="schedule-description">@courseSchedules.Course.Description</p>
                }
                <div class="schedule-meta">
                    <span><strong>Course Type:</strong> @courseSchedules.Course.CourseType</span>
                    <span><strong>Sessions:</strong> @(courseSchedules.Course.SessionCount?.ToString() ?? "N/A")</span>
                    <span><strong>@CurrentTenant.Terminology.ProviderSingular:</strong> @(courseSchedules.Course.Coach?.Name ?? "N/A")</span>
                    @if (courseSchedules.Course.CourseType == "Private")
                    {
                        <span><strong>Phone:</strong> @(courseSchedules.Course.Coach?.Phone ?? "N/A")</span>
                        <span><strong>WeChat:</strong> @(courseSchedules.Course.Coach?.Wechat ?? "N/A")</span>
                        <span><strong>WhatsApp:</strong> @(courseSchedules.Course.Coach?.WhatsApp ?? "N/A")</span>
                    }
                </div>
                <div class="schedule-status-summary" aria-label="Session status summary">
                    <span class="schedule-status-badge">Scheduled <strong class="status-scheduled">@scheduledCount</strong></span>
                    @if (courseSchedules.Course.CourseType == "Private")
                    {
                        <span class="schedule-status-badge">Deleted <strong class="status-deleted">@deletedCount</strong></span>
                    }
                    @if (courseSchedules.Course.CourseType == "Group")
                    {
                        <span class="schedule-status-badge">Canceled <strong class="status-canceled">@canceledCount</strong></span>
                    }
                    @if (courseSchedules.Course.CourseType == "Group")
                    {
                        <span class="schedule-status-badge">On Leave <strong class="status-request">@onLeaveCount</strong></span>
                    }
                    @if (courseSchedules.Course.CourseType == "Group")
                    {
                        <span class="schedule-status-badge">Request to Leave <strong class="status-request">@requestToLeaveCount</strong></span>
                    }
                    @if (courseSchedules.Course.CourseType == "Private")
                    {
                        <span class="schedule-status-badge">Request to Reschedule <strong class="status-request">@requestToRescheduleCount</strong></span>
                    }
                </div>
            </div>
            <button class="schedule-toggle" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#collapseCourse_@courseSchedules.Course.CourseID">
                View sessions
            </button>
        </div>
        <div id="collapseCourse_@courseSchedules.Course.CourseID" class="collapse schedule-details">
                 <div class="card-body">

            <form method="post" asp-action="UpdateSchedules">
                <input type="hidden" name="CourseID" value="@courseSchedules.Course.CourseID" />

               
                 <div class="schedule-table-wrapper">
                 <table class="management-table mobile-table table table-bordered mt-3" style="border-collapse: collapse; width: 100%; text-align: left; vertical-align:middle">

                           
                    <thead class="management-table-header">
                        <tr>
                            <th>Date</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Location</th>
                            <th>Status</th>
                       
                        
                            @if (courseSchedules.Course.CourseType == "Private")
                            {
                                <th width="20%">@CurrentTenant.Terminology.ProviderSingular Note</th>
                            }

                            @if (courseSchedules.Course.CourseType == "Group")
                            {
                                <th width="20%">@CurrentTenant.Terminology.ProviderSingular Note</th>
                            }

                            <th width="20%">My Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (courseSchedules.Schedules.Any())
                        {
                            @for (int i = 0; i < courseSchedules.Schedules.Count; i++)
                            {
                                var schedule = courseSchedules.Schedules[i];
                                //var isWithin24Hours = schedule.ScheduledAt.HasValue && (schedule.ScheduledAt.Value - now).TotalHours < 24;
                                var now = DateTime.UtcNow;
                                //var scheduledUtc = TimeZoneInfo.ConvertTimeToUtc(schedule.ScheduledAt.Value, TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time"));
                                var isWithin24Hours = (schedule.ScheduledAt.Value - now).TotalHours < 24;

                                <input type="hidden" name="Schedules[@i].EnrollmentID" value=@courseSchedules.Schedules[i].EnrollmentID>
                                <tr>
                           
                                    @{
                                        var scheduledAt = courseSchedules.Schedules[i].ScheduledAt.ToUserTime(User, AppTimeZoneService);
                                        var scheduledHours = courseSchedules.Schedules[i].ScheduledHours.HasValue ? (double)courseSchedules.Schedules[i].ScheduledHours.Value : 0;
                                        DateTime? endTime = scheduledAt?.AddHours(scheduledHours);
                                    }
                                          
                                    <td data-label="Date">
                                        @(scheduledAt.HasValue? scheduledAt.Value.ToString("yyyy-MM-dd") : "")
                                    </td>

                                    <td data-label="Start Time">
                                        @(scheduledAt.HasValue? scheduledAt.Value.ToString("HH:mm") : "")
                                    </td>

                                    <td data-label="End Time">
                                        @(endTime.HasValue? endTime.Value.ToString("HH:mm") : "")
                                    </td>

                                    <td data-label="Location">
                                        @courseSchedules.Schedules[i].Location
                                    </td>

                                    <td data-label="Status">
                                            <select name="Schedules[@i].Status" class="form-select" @(courseSchedules.Schedules[i].Status == "Canceled" || courseSchedules.Schedules[i].Status == "Deleted" || courseSchedules.Schedules[i].Status == "OnLeave" || isWithin24Hours ? "disabled" : "")> 
                                                <option value="Scheduled" selected="@(courseSchedules.Schedules[i].Status == "Scheduled")">Scheduled</option> 
                                                @if (courseSchedules.Course.CourseType == "Private") 
                                                {
                                                    <option value="RequestToReschedule" selected="@(courseSchedules.Schedules[i].Status == "RequestToReschedule")">Request to Reschedule</option>
                                                }
                                                @if (courseSchedules.Course.CourseType == "Group")
                                                {
                                                    <option value="RequestToLeave" selected="@(courseSchedules.Schedules[i].Status == "RequestToLeave")">Request to Leave</option>
                                                    <option value="OnLeave" disabled selected="@(courseSchedules.Schedules[i].Status == "OnLeave")">On Leave</option>
                                                    <option value="Canceled" disabled selected="@(courseSchedules.Schedules[i].Status == "Canceled")">Canceled</option>
                                                }
                                                 
                                                @if (courseSchedules.Course.CourseType == "Private")
                                                {
                                                    <option value="Deleted" disabled selected="@(courseSchedules.Schedules[i].Status == "Deleted")">Deleted</option>
                                                }
                                            </select>
                                    </td>

                                    <td data-label="@($"{CurrentTenant.Terminology.ProviderSingular} Note")">
                                        @if (courseSchedules.Course.CourseType == "Private")
                                        {
                                            @courseSchedules.Schedules[i].CoachNote
                                        }
                                        @if (courseSchedules.Course.CourseType == "Group")
                                        {
                                            @courseSchedules.Schedules[i].StaffNote
                                        }
                                    </td>

                                    <td data-label="My Note">
                                        <textarea name="Schedules[@i].ParentNote" class="form-control" @(courseSchedules.Schedules[i].Status == "Canceled" || courseSchedules.Schedules[i].Status == "Deleted" ? "disabled" : "")>
                                            @courseSchedules.Schedules[i].ParentNote
                                        </textarea>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 10px;">No schedules available.</td>
                            </tr>

                                  
                        }

                        @if (TempData["SuccessMessage1"] != null && TempData["CourseID"]?.ToString() == courseSchedules.Course.CourseID.ToString())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="alert alert-success">
                                        @TempData["SuccessMessage1"]
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (TempData["ErrorMessage1"] != null && TempData["CourseID"]?.ToString() == courseSchedules.Course.CourseID.ToString())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="alert alert-danger">
                                        @TempData["ErrorMessage1"]
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (TempData["WarningMessage1"] != null && TempData["CourseID"]?.ToString() == courseSchedules.Course.CourseID.ToString())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="alert alert-warning">
                                        @TempData["WarningMessage1"]
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
                <br/>
           
                @if (courseSchedules.Course.CourseType == "Group")
                {
                    <div style="padding: 10px 20px 10px 20px; margin: 0px 0px 20px 0px; border: 1px solid #ddd; background-color: #f8f9fa;">
                                If you can’t attend the session, select 'Request to Leave' and click 'Save Changes'. <br />
                               
                    </div>
                }

                @if (courseSchedules.Course.CourseType == "Private")
                {
                    <div style="padding: 10px 20px 10px 20px; margin: 0px 0px 20px 0px; border: 1px solid #ddd; background-color: #f8f9fa;">
                        You can request a reschedule by clicking 'Request to Reschedule' at least 24 hours before the session begins. 
                        
                    </div>
                }
               
                <button type="submit" class="btn classlift-secondary-button btn-save mt-2">
                    Save Changes
                </button>

             </form>

                 </div>
            </div>
        </section>
    }
}
else
{
        <div class="empty-schedules p-4 text-center">No schedules available.</div>
}
<div style="margin-bottom: 30px;"></div>




<h4 class="schedule-section-title">Activities</h4>



@if (Model.ActivitySchedules!=null && Model.ActivitySchedules.Any())
{
    @foreach (var enrollment in Model.ActivitySchedules)
    {
        <div class="schedule-card">
            <div class="schedule-summary">
                <div>
                    <h5>@enrollment.Activity.Title</h5>
                    <div class="schedule-meta">
                        <span><strong>Scheduled:</strong> @enrollment.Activity.ScheduledAt.ToUserTime(User, AppTimeZoneService).ToString("yyyy-MM-dd HH:mm")</span>
                        <span><strong>Address:</strong> @(string.IsNullOrWhiteSpace(enrollment.Activity.Address) ? "N/A" : enrollment.Activity.Address)</span>
                    </div>
                    <p class="schedule-description"><strong>Description:</strong> @(string.IsNullOrWhiteSpace(enrollment.Activity.Description) ? "N/A" : enrollment.Activity.Description)</p>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="empty-schedules p-4 text-center">No activities enrolled.</div>
}
</div>


