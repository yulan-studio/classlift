@model Core.ViewModels.ChildSchedulesToConfirmViewModel


<style>
    .confirmations-page { width: 100%; margin: 0 auto; padding: 0; box-sizing: border-box; }
    .confirmations-page h2 { margin: 0; color: #152238; font-size: clamp(1.45rem, 2vw, 1.75rem); font-weight: 700; }
    .confirmations-title { margin: 0; color: #152238; font-size: clamp(1.45rem, 2vw, 1.75rem); font-weight: 700; line-height: 1.2; }
    .confirmations-subtitle { margin: .35rem 0 0; color: #6b778c; font-size: .95rem; }
    .confirmation-section-title { margin: 1.5rem 0 .85rem; color: #1b7bab !important; font-size: 1.25rem; font-weight: 700; }
    .table-primary th { background-color: var(--classlift-blue-light) !important; color: #000; }
    .confirmations-page table tbody tr,
    .confirmations-page table tbody td { --bs-table-bg: #fbfcfd; background-color: #fbfcfd !important; }
    .card { border: 1px solid #d8e7f3; border-radius: 12px; box-shadow: 0 3px 12px rgba(24, 47, 76, .06); }
    .confirmations-page div[style*="background-color: #f8f9fa"] { border-radius: 8px; }
    .confirmations-page .empty-schedules { border: 1px dashed #ccd6e2; border-radius: 10px; color: #6b778c; background: #f9fbfd; }
    .confirmation-target { scroll-margin-top: 1rem; transition: box-shadow .25s ease, background-color .25s ease; }
    .confirmation-target--highlight { background-color: #fff8d8 !important; box-shadow: 0 0 0 3px #f0c36d; border-radius: 8px; }
    .confirmations-page #deleteRegistrationModal .modal-header { border-bottom: 1px solid var(--bs-border-color); }
    .confirmations-page #deleteRegistrationModal .modal-footer { border-top: 1px solid var(--bs-border-color); }
    .confirmations-page #deleteRegistrationModal .cancel-button,
    .confirmations-page #deleteRegistrationModal .cancel-button:hover,
    .confirmations-page #deleteRegistrationModal .cancel-button:focus { color: #fff !important; }
    .btn-primary { border-color: #7bb4dc; background-color: #7bb4dc; color: #fff; }
    .btn-primary:hover { border-color: #6aa8d3; background-color: #6aa8d3; color: #fff; }
    @@media (max-width: 767px) {
        table { min-width: 760px; }
    }
</style>
<div class="confirmations-page">
<h2 class="confirmations-title">Confirmations</h2>
<p class="confirmations-subtitle">Review and confirm your pending course and activity registrations.</p>

<div style="padding-top: 8px; padding-bottom: 12px">
    <h4 class="confirmation-section-title">Courses</h4>
</div>

@if (TempData["SuccessMessage2"] != null)
{

    <div class="alert alert-success">
        @Html.Raw(@TempData["SuccessMessage2"])
    </div>

}

@if (TempData["ErrorMessage2"] != null)
{

    <div class="alert alert-danger">
        @TempData["ErrorMessage2"]
    </div>

}

@if (TempData["WarningMessage2"] != null)
{
    <div class="alert alert-warning">
        @TempData["WarningMessage2"]
    </div>
}

@{
    bool hasCourseToConfirm = false;
}

@* Group course to confirm *@
@if (Model.CoursesSchedulesToConfirm.Any())
{
    hasCourseToConfirm = true;

    @foreach (var courseSchedulesToConfirm in Model.CoursesSchedulesToConfirm)
    {
        <div class="alert alert-warning" role="alert">
            Please confirm this Group course registration before 12:00 AM on the day of its first session. If it is not confirmed by then, the registration will be canceled.
        </div>

        <form id="course-enrollment-@courseSchedulesToConfirm.Fee.CourseEnrollmentID" class="confirmation-target" method="post" asp-action="UpdateSchedulesToConform">
            <input type="hidden" name="CourseID" value="@courseSchedulesToConfirm.Course.CourseID" />
            <input type="hidden" name="Fee.PaymentModel" value="@courseSchedulesToConfirm.Fee.PaymentModel" />
            <input type="hidden" name="Fee.TotalCost" value="@courseSchedulesToConfirm.Fee.TotalCost" />
            <input type="hidden" name="Fee.CourseEnrollmentID" value="@courseSchedulesToConfirm.Fee.CourseEnrollmentID" />

            <table class="mobile-stack table" style="border-collapse: collapse; width: 100%; text-align: left;">
                <thead class="table-primary">
                    <tr>
                        <th style="padding: 8px; border: 1px solid #ddd;">Course</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Description</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Session Count</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Session Cost</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">@courseSchedulesToConfirm.Course.Title</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@courseSchedulesToConfirm.Course.Description</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@courseSchedulesToConfirm.Course.SessionCount</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@courseSchedulesToConfirm.Course.SessionCost</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@(courseSchedulesToConfirm.Fee.CourseEnrollment?.Status ?? "Registered")</td>
                    </tr>
                </tbody>
            </table>

            <div class="mb-3">
                <button id="toggleBtn_@courseSchedulesToConfirm.Course.CourseID"
                        class="btn btn-grey"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapseCourse_@courseSchedulesToConfirm.Course.CourseID"
                        aria-expanded="false"
                        aria-controls="collapseCourse_@courseSchedulesToConfirm.Course.CourseID">
                    Show Schedules
                </button>

                <div id="collapseCourse_@courseSchedulesToConfirm.Course.CourseID" class="collapse mt-2">
                    <div class="card card-body">
                        <table style="border-collapse: collapse; width: 100%; text-align: left;">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th style="padding: 8px; border: 1px solid #ddd;" width="10%">Date</th>
                                    <th style="padding: 8px; border: 1px solid #ddd;" width="10%">Start Time</th>
                                    <th style="padding: 8px; border: 1px solid #ddd;" width="10%">End Time</th>
                                    <th style="padding: 8px; border: 1px solid #ddd;" width="15%">Location</th>
                                    <th style="padding: 8px; border: 1px solid #ddd;" width="15%">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (courseSchedulesToConfirm.Schedules.Any())
                                {
                                    @for (int i = 0; i < courseSchedulesToConfirm.Schedules.Count; i++)
                                    {
                                        var schedule = courseSchedulesToConfirm.Schedules[i];
                                        var scheduledAt = schedule.ScheduledAt.ToUserTime(User, AppTimeZoneService);
                                        var scheduledHours = schedule.ScheduledHours.HasValue ? (double)schedule.ScheduledHours.Value : 0;
                                        DateTime? endTime = scheduledAt?.AddHours(scheduledHours);

                                        <input type="hidden" name="Schedules[@i].EnrollmentID" value="@schedule.EnrollmentID" />
                                        <tr>
                                            <td style="padding: 8px; border: 1px solid #ddd;">
                                                @(scheduledAt.HasValue ? scheduledAt.Value.ToString("yyyy-MM-dd") : "")
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">
                                                @(scheduledAt.HasValue ? scheduledAt.Value.ToString("HH:mm") : "")
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">
                                                @(endTime.HasValue ? endTime.Value.ToString("HH:mm") : "")
                                            </td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@schedule.Location</td>
                                            <td style="padding: 8px; border: 1px solid #ddd;">@schedule.Status</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" style="text-align: center; padding-top: 10px;">
                                            There are currently no schedules waiting for your confirmation.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @if (!courseSchedulesToConfirm.Fee.IsPaid)
            {
                <div style="padding: 20px; margin: 20px 0; border: 1px solid #ddd; background-color: #f8f9fa;">
                    Total Cost: $@courseSchedulesToConfirm.Fee.TotalCost<br />
                    @(courseSchedulesToConfirm.Fee.Description)<br />
                </div>
            }

            <div style="padding: 20px; margin: 20px 0; border: 1px solid #ddd; background-color: #f8f9fa;">
                <div style="margin-bottom: 16px;">
                    <span style="display: block;">Please click <strong>"Confirm"</strong> and complete the payment together to complete your course registration.</span>
                    <span style="display: block; color: #b35a6a;">If you want to cancel this registration, please click <strong>"Delete"</strong> and do not make the payment.</span>
                </div>
                <button type="submit" name="actionType" value="Confirm" class="btn btn-primary mt-2">Confirm</button>
                <button type="button" class="btn btn-outline-danger mt-2 ms-2"
                        onclick="openDeleteRegistrationModal(this.form);">Delete</button>
            </div>
        </form>




        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const collapseId = 'collapseCourse_@courseSchedulesToConfirm.Course.CourseID';
                const buttonId = 'toggleBtn_@courseSchedulesToConfirm.Course.CourseID';

                const collapseElement = document.getElementById(collapseId);
                const buttonElement = document.getElementById(buttonId);

                collapseElement.addEventListener('show.bs.collapse', function () {
                    buttonElement.textContent = 'Hide Schedules';
                });

                collapseElement.addEventListener('hide.bs.collapse', function () {
                    buttonElement.textContent = 'Show Schedules';
                });
            });
        </script>



     
    }
}



@* Private course to confirm *@
@if (Model.PrivateCoursesToConfirm != null && Model.PrivateCoursesToConfirm.Any())
{
    hasCourseToConfirm = true;

    @foreach (var enrollment in Model.PrivateCoursesToConfirm)
    {


        <form id="course-enrollment-@enrollment.EnrollmentID" class="confirmation-target" method="post" asp-action="UpdateCourseToConform">
            <input type="hidden" name="CourseID" value="@enrollment.CourseID" />
            <input type="hidden" name="EnrollmentID" value="@enrollment.EnrollmentID" />
            <input type="hidden" name="TotalCost" value="@enrollment.TotalCost" />
            <input type="hidden" name="PaymentModel" value="@enrollment.PaymentModel" />
            @* <table class="mobile-stack table table-bordered mt-2" style="border-collapse: collapse; width: 100%; text-align: left;"> *@
            <table class="mobile-stack table" style="border-collapse: collapse; width: 100%; text-align: left;">
                <thead class="table-primary">
                    <tr>
                        <th style="padding: 8px; border: 1px solid #ddd;">Course</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Description</th>
                        @if (enrollment.SessionCount.HasValue)
                        {
                            <th style="padding: 8px; border: 1px solid #ddd;">Session Count</th>
                            <th style="padding: 8px; border: 1px solid #ddd;">Session Cost</th>
                        }
                        else
                        {
                            <th style="padding: 8px; border: 1px solid #ddd;">Hourly Cost</th>
                        }
                        <th style="padding: 8px; border: 1px solid #ddd;">Status</th>

                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Title</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Description</td>
                        @if (enrollment.SessionCount.HasValue)
                        {
                            <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.SessionCount</td>
                            <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.SessionCost</td>
                        }
                        else
                        {
                            <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.HourlyCost</td>
                        }
                        <td style="padding: 8px; border: 1px solid #ddd;@(enrollment.Status == "Canceled" ? "color: red" : "")">@enrollment.Status</td>

                    </tr>
                </tbody>
            </table>
            <br />

            <div  style="padding: 20px 20px 20px 20px; margin: 0px 0px 20px 0px; border: 1px solid #ddd; background-color: #f8f9fa;">

                Total Cost: $@enrollment.TotalCost<br />
                @(enrollment.PaymentDescription)<br />

            </div>



            <div @* class="alert alert-danger" *@  style="padding: 20px 20px 20px 20px; margin: 20px 0px 20px 0px; border: 1px solid #ddd; background-color: #f8f9fa;">
                

                 <div style="margin-bottom: 16px;">
                    <span style="display: block;">Please click <strong>"Confirm"</strong> and complete the payment together to complete your course registration.</span>
                    <span style="display: block; color: #b35a6a;">If you want to cancel this registration, please click <strong>"Delete"</strong> and do not make the payment.</span>
                </div>
                <button type="submit" name="actionType" value="Confirm" class="btn btn-primary mt-2">Confirm</button>
                <button type="button" class="btn btn-outline-danger mt-2 ms-2"
                        onclick="openDeleteRegistrationModal(this.form);">Delete</button>

            </div>
        </form>


    }

}



@if(!hasCourseToConfirm)
{
    <div class="empty-schedules p-4 text-center">No course available for confirmation.</div>
}

<div style="padding-top: 20px; padding-bottom: 12px">
    <h4 class="confirmation-section-title">Activities</h4>
</div>

<div id="deleteRegistrationModal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Remove Registration</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to remove this registration?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" onclick="confirmDeleteRegistration();">Delete</button>
                <button type="button" class="btn btn-secondary cancel-button" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
    let deleteRegistrationForm = null;

    function openDeleteRegistrationModal(form) {
        deleteRegistrationForm = form;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteRegistrationModal')).show();
    }

    function confirmDeleteRegistration() {
        if (!deleteRegistrationForm) return;

        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'actionType';
        actionInput.value = 'Delete';
        deleteRegistrationForm.appendChild(actionInput);
        deleteRegistrationForm.submit();
    }
</script>

@if (TempData["SuccessMessage3"] != null)
{

    <div class="alert alert-success">
        @Html.Raw(@TempData["SuccessMessage3"])
    </div>

}

@if (TempData["ErrorMessage3"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage3"]</div>

}

@if (TempData["WarningMessage3"] != null)
{
    <div class="alert alert-warning">
        @TempData["WarningMessage3"]
    </div>
}
@if (Model.ActivitiesToConfirm != null && Model.ActivitiesToConfirm.Any())
{

    @foreach (var enrollment in Model.ActivitiesToConfirm)
    {


        <form id="activity-enrollment-@enrollment.EnrollmentID" class="confirmation-target" method="post" asp-action="UpdateActivityToConform">
            <input type="hidden" name="ActivityID" value="@enrollment.ActivityID" />
            <input type="hidden" name="EnrollmentID" value="@enrollment.EnrollmentID" />
            <input type="hidden" name="TotalCost" value="@enrollment.TotalCost" />
            <input type="hidden" name="PaymentModel" value="@enrollment.PaymentModel" />
            <table style="border-collapse: collapse; width: 100%; text-align: left;">
                <thead class="table-primary">
                    <tr>
                        <th style="padding: 8px; border: 1px solid #ddd;">Activity</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Description</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Address</th>
                        <th style="padding: 8px; border: 1px solid #ddd;">Scheduled At</th>
                        @*  <th style="padding: 8px; border: 1px solid #ddd;">Cost</th> *@
                        <th style="padding: 8px; border: 1px solid #ddd;">Status</th>
                        @*  <th style="padding: 8px; border: 1px solid #ddd;">Actions</th> *@
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Title</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Description</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.Address</td>
                        <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.ScheduledAt.ToUserTime(User, AppTimeZoneService).ToString("yyyy-MM-dd HH:mm")</td>
                        @*  <td style="padding: 8px; border: 1px solid #ddd;">@enrollment.TotalCost</td> *@
                        <td style="padding: 8px; border: 1px solid #ddd;@(enrollment.Status == "Canceled" ? "color: red" : "")">@enrollment.Status</td>

                    </tr>
                </tbody>
            </table>
            <br />

            <div @* class="alert alert-danger" *@  style="padding: 10px 20px 10px 20px; margin: 20px 0px 20px 0px; border: 1px solid #ddd; background-color: #f8f9fa;">

                Total Cost: @enrollment.TotalCost<br />
                @(enrollment.PaymentDescription)<br />

            </div>



            <div @* class="alert alert-danger" *@  style="padding: 20px 20px 20px 20px; margin: 20px 0px 20px 0px; border: 1px solid #ddd; background-color: #f8f9fa;">
                Please click 'Confirm' to complete your activity registration.<br />
                <span style="color: #8b1e2d;">If you want to cancel this activity registration, click <strong>Delete</strong>.</span><br /><br />
                <div style="display: flex; align-items: center; gap: 8px;">
                    <button type="submit" name="actionType" value="Confirm" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; cursor: pointer;">Confirm</button>
                    <button type="button" class="btn btn-outline-danger"
                            onclick="openDeleteRegistrationModal(this.form);">Delete</button>
                </div>

            </div>
        </form>


    }

}
else
{
    <div class="empty-schedules p-4 text-center">No activity available for confirmation.</div>
}
</div>

<script>
    (function () {
        function focusConfirmation() {
            const target = document.getElementById(window.location.hash.substring(1));
            if (!target) return;

            const collapsed = target.querySelector('.collapse');
            if (collapsed && !collapsed.classList.contains('show') && window.bootstrap) {
                collapsed.addEventListener('shown.bs.collapse', reveal, { once: true });
                window.bootstrap.Collapse.getOrCreateInstance(collapsed).show();
            } else {
                reveal();
            }

            function reveal() {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                target.classList.add('confirmation-target--highlight');
                window.setTimeout(function () {
                    target.classList.remove('confirmation-target--highlight');
                }, 3000);
            }
        }

        window.addEventListener('load', focusConfirmation);
        window.addEventListener('hashchange', focusConfirmation);
    })();
</script>













