@model Core.Models.Child

@{
    Layout = null;
}
@{
    ViewData["Title"] = "Child Notes";
}

<style>
    .notes-panel .classlift-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px !important;
        min-height: 40px !important;
        padding: 8px 14px !important;
        border-radius: 5px !important;
        box-sizing: border-box;
    }

    @@media (max-width: 767px) {
        .notes-panel .classlift-button {
            height: 42px !important;
            min-height: 42px !important;
        }
    }
</style>

<div class="notes-panel" style="padding: 20px; background-color: #f2f2f2">
<h3 style="padding-bottom:10px">Notes</h3>



<!-- ✅ Form to Add a New Payment -->


    <form asp-action="ManageNotes" method="post">
        <input type="hidden" asp-for="ChildID" />
        <input type="hidden" name="childId" value=@Model.ChildID/>

        <div class="form-group mb-3">
           
            <textarea asp-for="Notes" class="form-control" rows="15" style="width:100%;"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary classlift-button">Save</button>
    </form>


    @if (TempData["SuccessMessage"] != null)
   {
        <div style="padding-top: 20px;">
        </div>
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }



</div>
