<style>
    .more-info-summary-wrapper, .more-info-tabs-wrapper { width: 100%; overflow-x: auto; }
    .more-info-summary-table { width: 100%; min-width: 760px; border-collapse: collapse; text-align: left; }
    .more-info-tabs { flex-wrap: nowrap; min-width: max-content; }
    @@media (max-width: 767px) {
        .more-info-summary-wrapper, .more-info-tabs-wrapper { max-width: 100%; overflow-x: scroll; -webkit-overflow-scrolling: touch; }
        .more-info-summary-table { width: 760px; min-width: 760px; }
        .more-info-summary-table th, .more-info-summary-table td { padding: 6px !important; }
        .more-info-tabs .nav-link { white-space: nowrap; }
        #contentArea { padding: 10px !important; overflow-x: hidden; }
        #contentArea table { display: block; max-width: 100%; overflow-x: auto; white-space: nowrap; }
    }
</style>

<div class="more-info-summary-wrapper">
<table class="more-info-summary-table">
    <thead>
        <tr style="background-color: #f2f2f2;">
            <th style="padding: 8px; border: 1px solid #ddd;">Name</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Member ID</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Birth Date</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Gender</th>
            <th style="padding: 8px; border: 1px solid #ddd;">City</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Phone</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Email</th>
           @*  <th style="padding: 8px; border: 1px solid #ddd;">Phone</th>
            <th style="padding: 8px; border: 1px solid #ddd;">WeChat</th>
            <th style="padding: 8px; border: 1px solid #ddd;">WhatsApp</th> *@
        </tr>
    </thead>

    <tbody>
        <tr>
            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Name</td>
            <td style="padding: 8px; border: 1px solid #ddd;">@Model.MemberID</td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                @(Model.BirthDate.HasValue? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "N/A")
            </td>
            <td style="padding: 8px; border: 1px solid #ddd;">@Model.Gender</td>
            <td style="padding: 8px; border: 1px solid #ddd;">
                @(Model.City != null ? Model.City.Name : "N/A")
            </td>
            <td style="padding: 8px; border: 1px solid #ddd;">@(Model.Phone ?? "N/A")</td>
            <td style="padding: 8px; border: 1px solid #ddd;">@(Model.User.Email ?? "N/A")</td>
          @*   <td style="padding: 8px; border: 1px solid #ddd;">@(Model.Phone ?? "N/A")</td>
            <td style="padding: 8px; border: 1px solid #ddd;">@(Model.WeChat ?? "N/A")</td>
            <td style="padding: 8px; border: 1px solid #ddd;">@(Model.WhatsApp ?? "N/A")</td> *@
        </tr>
    </tbody>
</table>
</div>


<a href="/Child/List" style="display: inline-block; margin-top: 20px; background-color: #ddd; color: black; text-decoration: none; padding: 5px 10px; margin-right: 20px; border: 1px solid #ccc;">Back to @CurrentTenant.Terminology.ParticipantPlural List</a>
<a href="/Child/Participation/@Model.ChildID">Participation</a>
<div style="border-top: 2px solid #ddd; margin: 20px 0;"></div>

<div class="more-info-tabs-wrapper">
<ul class="nav nav-tabs more-info-tabs mb-3">
    <li class="nav-item"><a class ="nav-link @(ViewBag.ActiveTab == "CoreInfo" || (!CurrentTenant.Terminology.ParticipantsRequireParentSupport && ViewBag.ActiveTab == "Parents") ? "active" : "")" href="#" data-url="/Child/CoreInfo/@Model.ChildID">Core Member Information</a></li>
    <li class="nav-item"><a class="nav-link @(ViewBag.ActiveTab == "EmergencyContacts" ? "active" : "")" href="#" data-url="/Child/EmergencyContacts/@Model.ChildID">Emergency Contacts</a></li>
    @if (CurrentTenant.Terminology.ParticipantsRequireParentSupport)
    {
        <li class="nav-item"><a class="nav-link @(ViewBag.ActiveTab == "Parents" ? "active" : "")" href="#" data-url="/Child/Parents/@Model.ChildID">Parents / Guardians</a></li>
    }
    @* <li class="nav-item"><a class="nav-link @(ViewBag.ActiveTab == "ManagePayments" ? "active" : "")" href="#" data-url="/Child/ManagePayments/@Model.ChildID">Payments</a></li>
    <li class="nav-item"><a class="nav-link @(ViewBag.ActiveTab == "Registerations" ? "active" : "")" href="#" data-url="/Child/Registrations/@Model.ChildID">Registrations</a></li>
    <li class="nav-item"><a class="nav-link @(ViewBag.ActiveTab == "EnrollmentsHistory" ? "active" : "")" href="#" data-url="/Child/EnrollmentsHistory/@Model.ChildID">Enrollments</a></li> *@
    @* <li class="nav-item"><a class="nav-link" href="#" data-url="/Child/ManageRegistrations/@Model.ChildID">Manage Registration</a></li> *@
    @*<li class="nav-item"><a class="nav-link" href="#" data-url="/Course/List?childId=@Model.Id">Courses</a></li> *@
</ul>
</div>

<!-- Content Area -->
<div id="contentArea" class="border p-3">
    <!-- Subpage will load here -->
</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // alert("Page ready!");
            // Load first tab by default
            

            var activeLink = $("ul.nav-tabs a.active");
            var url = activeLink.data("url");

            // if we are on Parents tab, append editParentId
            var editParentId = '@(ViewBag.EditParentId ?? 0)';
            if (activeLink.text().includes("Parents") && editParentId > 0) {
                url += "?editParentId=" + editParentId;
            }
            $("#contentArea").load(url);


            // Handle clicks
            $("ul.nav-tabs a").on("click", function (e) {
                e.preventDefault();
                $("ul.nav-tabs a").removeClass("active");
                $(this).addClass("active");

                var url = $(this).data("url");
                $("#contentArea").load(url);
            });
        });
    </script>
}



