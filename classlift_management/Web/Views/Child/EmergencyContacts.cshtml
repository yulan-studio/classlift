@model Core.Models.Child

@{
    Layout = null;
}

<h3>Emergency Contacts</h3>
<div style="padding-top: 20px;">
</div>

<style>
    .emergency-contacts-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .emergency-contacts-table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
        text-align: left;
    }

    .emergency-contact-form {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }

    .emergency-contact-form input {
        width: 180px;
        min-height: 40px;
        padding: 8px 12px;
        box-sizing: border-box;
        border: 1px solid #cbd8de;
        border-radius: 5px;
        background-color: #fff;
        color: #212529;
    }

    .emergency-contact-form input:focus {
        border-color: #1b7bab;
        outline: 0;
        box-shadow: 0 0 0 3px rgba(27, 123, 171, 0.15);
    }

    .emergency-contact-form button,
    .emergency-contacts-table button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 40px !important;
        min-height: 40px !important;
        padding: 8px 14px !important;
        border-radius: 5px !important;
        box-sizing: border-box;
    }

    @@media (max-width: 767px) {
        .emergency-contacts-table-wrapper {
            overflow-x: scroll;
            -webkit-overflow-scrolling: touch;
        }

        .emergency-contact-form {
            flex-direction: column;
            align-items: stretch;
            gap: 8px;
        }

        .emergency-contact-form input,
        .emergency-contact-form button {
            width: 100%;
            min-height: 42px;
            height: 42px !important;
            box-sizing: border-box;
        }
    }
</style>

<div class="emergency-contacts-table-wrapper">
<table class="management-table emergency-contacts-table">
    <thead class="child-management-table-header">
        <tr>
            <th style="padding: 8px; border: 1px solid #ddd;">Name</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Relationship</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Phone</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Email</th>
            <th style="padding: 8px; border: 1px solid #ddd;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contact in Model.EmergencyContacts ?? Enumerable.Empty<Core.Models.EmergencyContact>())
        {
            <tr>
                <td style="padding: 8px; border: 1px solid #ddd;">@contact.ContactName</td>
                <td style="padding: 8px; border: 1px solid #ddd;">@contact.Relationship</td>
                <td style="padding: 8px; border: 1px solid #ddd;">@contact.Phone</td>
                <td style="padding: 8px; border: 1px solid #ddd;">@contact.Email</td>
                <td style="padding: 8px; border: 1px solid #ddd;">
                    <form asp-action="DeleteEmergencyContact" asp-route-contactId="@contact.EmergencyContactID" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="childId" value="@Model.ChildID" />
                        <button type="submit" class="btn btn-danger btn-sm classlift-button">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div style="margin-bottom: 40px;"></div>

<form class="emergency-contact-form" asp-action="AddEmergencyContact" asp-route-childId="@Model.ChildID" method="post">
    @Html.AntiForgeryToken()
    <input class="classlift-control" name="contactName" placeholder="Contact Name" required />
    <input class="classlift-control" name="relationship" placeholder="Relationship" required />
    <input class="classlift-control" name="phone" placeholder="Phone" required />
    <input class="classlift-control" name="email" type="email" placeholder="Email" required />
    <button type="submit" class="btn btn-danger btn-sm classlift-button">Add Contact</button>
</form>
