@model Core.Models.Child

@{
    Layout = null;
}

<h3>Core Information</h3>
<div style="padding-top: 20px;">
  
</div>

<style>
    .core-info-form-table { border-collapse: collapse; width: 100%; max-width: 600px; text-align: left; }
    @@media (max-width: 767px) {
        .core-info-form-table, .core-info-form-table tbody, .core-info-form-table tr, .core-info-form-table td { display: block; width: 100%; }
        .core-info-form-table tr { margin-bottom: 12px; }
        .core-info-form-table td { padding: 4px 0 !important; }
        .core-info-form-table td:first-child { padding-bottom: 0 !important; }
        .core-info-form-table input:not([type="checkbox"]) { width: 100%; min-height: 42px; box-sizing: border-box; }
        .core-info-form-table input[type="checkbox"] { margin-left: 0; }
        .core-info-form-table + br + br + button { min-height: 42px; padding: 10px 16px !important; }
    }
</style>

<form asp-action="CoreInfo" method="post">


    <table class="core-info-form-table">

        <tr>
            <td style="padding: 8px;"><label asp-for="MemberID">Member ID</label></td>
            <td style="padding: 8px;">
                @* <input type="text" name="memberID" placeholder="Enter child's Member ID" style="width: 100%;" /> *@
                <input asp-for="MemberID" class="form-control" />
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label asp-for="PrimaryDiagnosis">Primary Diagnosis</label></td>
            <td style="padding: 8px;">
                @* <input type="text" name="memberID" placeholder="Enter child's Member ID" style="width: 100%;" /> *@
                <input asp-for="PrimaryDiagnosis" class="form-control" />
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label asp-for="City">City</label></td>
            <td style="padding: 8px;">
                @(Model.City != null ? Model.City.Name : "N/A")
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label asp-for="Address">Address</label></td>
            <td style="padding: 8px;">
                <input asp-for="Address" class="form-control" />
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label asp-for="PostCode">Post Code</label></td>
            <td style="padding: 8px;">
                <input asp-for="PostCode" class="form-control" maxlength="10" />
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="email">Email</label></td>
            <td style="padding: 8px;">
                <input id="email" name="email" type="email" value="@Model.User.Email" maxlength="256" class="form-control" />
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label asp-for="Phone"></label></td>
            <td style="padding: 8px;"><input asp-for="Phone" type="tel" class="form-control" /></td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label asp-for="WeChat"></label></td>
            <td style="padding: 8px;"><input asp-for="WeChat" class="form-control" /></td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label asp-for="WhatsApp"></label></td>
            <td style="padding: 8px;"><input asp-for="WhatsApp" type="tel" class="form-control" /></td>
        </tr>
     @*    <tr>
            <td style="padding: 8px;"><label asp-for="OAPAmount"></label></td>
            <td style="padding: 8px;">
                <input asp-for="OAPAmount" type="number" class="form-control" />
            </td>
        </tr> *@
        <tr>
            <td style="padding: 8px;"><label asp-for="PhotoConsent">Photo Consent</label></td>
            <td style="padding: 8px;">
                <input asp-for="PhotoConsent" type="checkbox" class="form-check-input" />
            </td>
        </tr>
    </table>



    <br /><br />
    <button type="submit" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; cursor: pointer;">Save</button>
</form>
