@*
    Add Child Page - Follows the same format as Staff Add Page
*@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Child";
}

<h2>Add @CurrentTenant.Terminology.ParticipantSingular</h2>

<form method="post" action="/Child/Add">
    <table style="border-collapse: collapse; width: 50%; text-align: left;">

        @* <tr>
            <td style="padding: 8px;"><label for="memberID">Member ID:</label></td>
            <td style="padding: 8px;">
                <input type="text" name="memberID" placeholder="Enter child's Member ID" style="width: 100%;"  />
            </td>
        </tr> *@

        <tr>
            <td style="padding: 8px;"><label for="Name">Name:</label></td>
            <td style="padding: 8px;">
                <input type="text" name="name" placeholder="Enter child's name" style="width: 100%;" required />
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="birthDate">Birth Date:</label></td>
            <td style="padding: 8px;">
                <input type="date" name="birthDate" style="width: 100%;" />
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="gender">Gender:</label></td>
            <td style="padding: 8px;">
                <select name="gender" style="width: 100%;">
                    <option value="" selected>-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="N/A">N/A</option>
                </select>
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="provinceId">Province:</label></td>
            <td style="padding: 8px;">
                <select name="provinceId" id="provinceId" style="width: 100%;" required>
                    <option value="">-- Select Province --</option>
                    @foreach (var province in ViewBag.ProvinceList)
                    {
                        if (province.Selected)
                        {
                            <option value="@province.Value" selected>@province.Text</option>
                        }
                        else
                        {
                            <option value="@province.Value">@province.Text</option>
                        }
                    }
                </select>
                @if (ViewData.ModelState["provinceId"]?.Errors.Count > 0)
                {
                    <span class="text-danger">@ViewData.ModelState["provinceId"]!.Errors[0].ErrorMessage</span>
                }
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="cityID">City:</label></td>
            <td style="padding: 8px;">
                <select name="cityID" id="cityId" style="width: 100%;" required @(ViewBag.CityList.Count == 0 ? "disabled" : null)>
                    <option value="">-- Select City --</option>
                    @foreach (var city in ViewBag.CityList)
                    {
                        if (city.Selected)
                        {
                            <option value="@city.Value" selected>@city.Text</option>
                        }
                        else
                        {
                            <option value="@city.Value">@city.Text</option>
                        }
                    }
                </select>
                @if (ViewData.ModelState["cityId"]?.Errors.Count > 0)
                {
                    <span class="text-danger">@ViewData.ModelState["cityId"]!.Errors[0].ErrorMessage</span>
                }
                <small id="cityHelp" style="display: block; color: darkslategray;">
                    Select a province first.
                </small>
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="hasOAP">Has OAP:</label></td>
            <td style="padding: 8px;">
                <select name="hasOAP" style="width: 100%;">
                    <option value="" selected>-- Select Has OAP --</option>
                    <option value= "true">True</option>
                    <option value= "false">False</option>
                </select>
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="email">Email:</label></td>
            <td style="padding: 8px;"><input type="email" name="email" placeholder="Email" style="width: 100%;" /></td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="password">Password:</label></td>
            <td style="padding: 8px;"><input type="text" name="password" placeholder="Password" value="hello123!" style="width: 100%;" /></td>
        </tr>

        <tr>
            <td colspan="2" style="text-align: left; padding: 20px 16px 16px 8px;">
                <button type="submit" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; cursor: pointer;">
                    Add @CurrentTenant.Terminology.ParticipantSingular
                </button>
                <a href="/Child/List" style="background-color: #ddd; color: black; text-decoration: none; padding: 5px 10px; border: 1px solid #ccc;">
                    Cancel
                </a>
            </td>
        </tr>

        @if (TempData["SuccessMessage"] != null)
        {
            <tr>
                <td colspan="2">
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                </td>
            </tr>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <tr>
                <td colspan="2">
                    <div class="alert alert-danger">
                        @TempData["ErrorMessage"]
                    </div>
                </td>
            </tr>
        }
    </table>
</form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const provinceSelect = document.getElementById("provinceId");
        const citySelect = document.getElementById("cityId");
        const cityHelp = document.getElementById("cityHelp");

        provinceSelect.addEventListener("change", async function () {
            citySelect.innerHTML = '<option value="">-- Select City --</option>';
            citySelect.disabled = true;

            if (!provinceSelect.value) {
                cityHelp.textContent = "Select a province first.";
                return;
            }

            cityHelp.textContent = "Loading cities...";

            try {
                const response = await fetch(`/Child/CitiesByProvince/${provinceSelect.value}`);
                if (!response.ok) throw new Error("Unable to load cities.");

                const cities = await response.json();
                cities.forEach(function (city) {
                    const option = document.createElement("option");
                    option.value = city.value;
                    option.textContent = city.text;
                    citySelect.appendChild(option);
                });

                citySelect.disabled = cities.length === 0;
                cityHelp.textContent = cities.length === 0
                    ? "No cities are configured for this province."
                    : "Select a city.";
            } catch {
                cityHelp.textContent = "Cities could not be loaded. Please try again.";
            }
        });

        if (citySelect.options.length > 1) {
            cityHelp.textContent = "Select a city.";
        }
    });
</script>
