@model Core.ViewModels.HomePageSettingsViewModel

<h4>Home page</h4>
<p class="text-muted">Enter the website that should appear inside the Home page.</p>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success" role="alert">@ViewBag.SuccessMessage</div>
}

<form asp-controller="Account" asp-action="HomePage" method="post" class="settings-subform">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="PageUrl" class="form-label"></label>
        <input asp-for="PageUrl"
               class="form-control"
               type="url"
               inputmode="url"
               placeholder="https://example.com/" />
        <span asp-validation-for="PageUrl" class="text-danger"></span>
        <div class="form-text">The website must allow its pages to be displayed inside an iframe.</div>
    </div>

    <button type="submit" class="btn btn-primary">Save URL</button>
</form>
