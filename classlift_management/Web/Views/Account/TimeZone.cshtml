@model Core.ViewModels.TimeZonePreferenceViewModel
@using Core.Models

@{
    ViewData["Title"] = "Time zone";
    var timeZones = (IReadOnlyList<TimeZoneOption>)ViewBag.TimeZones;
}

<h2>Time zone</h2>
<p>This is your default zone for displaying schedules and creating new events.</p>

<form asp-action="TimeZone" method="post" style="max-width: 560px;">
    <input asp-for="ReturnUrl" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="TimeZoneId" class="form-label">Default time zone</label>
    <select asp-for="TimeZoneId" class="form-select" required>
        @foreach (var zone in timeZones)
        {
            <option value="@zone.Id">@zone.DisplayName (@zone.Id)</option>
        }
    </select>
    <span asp-validation-for="TimeZoneId" class="text-danger"></span>
    <button type="submit" class="btn btn-primary mt-3">Save time zone</button>
</form>
