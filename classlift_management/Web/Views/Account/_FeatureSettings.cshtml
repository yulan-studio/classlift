@model IReadOnlyList<Core.Models.OrganizationFeatureSettingDto>

<h4>Feature settings</h4>
<p class="text-muted">Choose which organization-configurable features are enabled for your organization.</p>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success" role="alert">@ViewBag.SuccessMessage</div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">There are no configurable features available.</p>
}
else
{
    foreach (var feature in Model)
    {
        <form asp-controller="Account" asp-action="FeatureSettings" method="post" class="settings-form border rounded p-3 mb-3" style="max-width: 720px;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="featureKey" value="@feature.FeatureKey" />
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <label class="form-label fw-semibold mb-1">@feature.FeatureName</label>
                    @if (!string.IsNullOrWhiteSpace(feature.Description))
                    {
                        <div class="form-text">@feature.Description</div>
                    }
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="isEnabled" value="true" @(feature.IsEnabled ? "checked" : null) onchange="this.form.requestSubmit()" />
                    <span class="form-check-label">@(feature.IsEnabled ? "Enabled" : "Disabled")</span>
                </div>
            </div>
        </form>
    }
}
