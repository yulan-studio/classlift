@{
    ViewData["Title"] = "Settings";
}

<h2 class="mb-4">Settings</h2>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "TimeZone" ? "active" : "")"
           href="#"
           data-url="/Account/TimeZone">Time Zone</a>
    </li>
    @if (User.IsInRole("Child") || User.IsInRole("Coach") || User.IsInRole("Staff"))
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "ChangePassword" ? "active" : "")"
               href="#"
               data-url="/Account/ChangePassword">Change Password</a>
        </li>
    }
    @if (User.IsInRole("Staff"))
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "ResetPassword" ? "active" : "")"
               href="#"
               data-url="/Account/ResetPassword">Reset Password</a>
        </li>
    }
</ul>

<div id="contentArea" class="border p-3">
    <div class="text-muted">Loading settings...</div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            function loadTab(link) {
                $("ul.nav-tabs a").removeClass("active");
                link.addClass("active");
                $("#contentArea").load(link.data("url"));
            }

            var activeLink = $("ul.nav-tabs a.active");
            loadTab(activeLink.length ? activeLink : $("ul.nav-tabs a").first());

            $("ul.nav-tabs a").on("click", function (event) {
                event.preventDefault();
                loadTab($(this));
            });

            $(document).on("submit", ".settings-form", function (event) {
                event.preventDefault();
                var form = $(this);

                $.ajax({
                    url: form.attr("action"),
                    method: "POST",
                    data: form.serialize(),
                    success: function (html) {
                        $("#contentArea").html(html);
                    }
                });
            });
        });
    </script>
}
