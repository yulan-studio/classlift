@{
    ViewData["Title"] = "Settings";
}

<style>
    .settings-page { width: 100%; margin: 0 auto; padding: 0; box-sizing: border-box; }
</style>

<div class="settings-page">
<h2 class="management-page-title">Settings</h2>

<style>
    html {
        overflow-y: scroll;
    }

    #contentArea h4 {
        margin-bottom: 1rem;
        color: #26364d;
        font-size: 1.1rem;
        font-weight: 650;
        line-height: 1.3;
    }
</style>

<style>
    .settings-tabs .nav-link,.settings-tabs .nav-link:hover,.settings-tabs .nav-link:focus,.settings-tabs .nav-link.active { color:#000 !important; }
</style>

<ul class="nav nav-tabs settings-tabs mb-3">
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "Branding" ? "active" : "")"
               href="#"
               data-url="/Account/Branding">Branding</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "EmailSettings" ? "active" : "")"
               href="#"
               data-url="/Account/EmailSettings">Email</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "FeatureSettings" ? "active" : "")"
               href="#"
               data-url="/Account/FeatureSettings">Feature Settings</a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link @(ViewBag.ActiveTab == "TimeZone" ? "active" : "")"
           href="#"
           data-url="/Account/TimeZone">Time Zone</a>
    </li>
    @if (User.IsInRole("Coach"))
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "CoachContactSettings" ? "active" : "")"
               href="#"
               data-url="/Account/CoachContactSettings">Profile Details</a>
        </li>
    }
    @if (User.IsInRole("Admin") || User.IsInRole("Child") || User.IsInRole("Coach") || User.IsInRole("Staff"))
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "ChangePassword" ? "active" : "")"
               href="#"
               data-url="/Account/ChangePassword">Change Password</a>
        </li>
    }
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.ActiveTab == "ResetPassword" ? "active" : "")"
               href="#"
               data-url="/Account/ResetPassword">Reset Password</a>
        </li>
    }
</ul>

<div id="contentArea" class="border p-3">
    <div class="text-muted">Loading settings...</div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            function loadTab(link) {
                $(".settings-tabs .nav-link").removeClass("active");
                link.addClass("active");
                var url = link.attr("data-url");
                if (!url) return;
                $("#contentArea").html('<div class="text-muted">Loading settings...</div>');
                $("#contentArea").load(url, function (response, status, xhr) {
                    if (status === "error") {
                        $("#contentArea").html(
                            '<div class="alert alert-danger" role="alert">The settings could not be loaded. Please try again.</div>');
                    }
                });
            }

            var activeLink = $(".settings-tabs .nav-link.active");
            loadTab(activeLink.length ? activeLink : $(".settings-tabs .nav-link").first());

            $(document).on("click", ".settings-tabs .nav-link", function (event) {
                event.preventDefault();
                loadTab($(this));
            });

            $(document).on("submit", ".settings-form", function (event) {
                event.preventDefault();
                var form = $(this);
                var formData = new FormData(form[0]);

                $.ajax({
                    url: form.attr("action"),
                    method: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        $("#contentArea").html(html);
                        var updatedLogo = $("#contentArea [data-updated-logo-url]").attr("data-updated-logo-url");
                        if (updatedLogo) {
                            var refreshedLogoUrl = updatedLogo + (updatedLogo.indexOf("?") >= 0 ? "&" : "?") + "clientCache=" + Date.now();
                            $("#logoPreview")
                                .attr("src", refreshedLogoUrl)
                                .removeAttr("onerror");
                            $("#organizationLogo")
                                .attr("onerror", "this.onerror=null;this.src=this.dataset.fallbackUrl;")
                                .attr("src", refreshedLogoUrl);
                            $("#organizationFavicon")
                                .attr("onerror", "this.onerror=null;this.href=this.dataset.fallbackUrl;")
                                .attr("href", refreshedLogoUrl);
                        }
                    },
                    error: function (xhr) {
                        if (xhr.responseText) {
                            $("#contentArea").html(xhr.responseText);
                        }
                    }
                });
            });

            $(document).on("submit", ".settings-subform", function (event) {
                event.preventDefault();
                var form = $(this);

                $.ajax({
                    url: form.attr("action"),
                    method: "POST",
                    data: new FormData(form[0]),
                    processData: false,
                    contentType: false,
                    success: function (html) {
                        form.closest(".settings-subsection").html(html);
                    }
                });
            });

            $(document).on("change", "#Logo", function () {
                if (this.files && this.files[0]) {
                    $("#logoPreview").attr("src", URL.createObjectURL(this.files[0]));
                }
            });

            $(document).on("change", "#organizationType", function () {
                var selected = $(this).find(":selected");
                if ($(this).val() === "Custom") return;

                $("#ProviderSingular").val(selected.data("provider"));
                $("#ProviderPlural").val(selected.data("providers"));
                $("#ParticipantSingular").val(selected.data("participant"));
                $("#ParticipantPlural").val(selected.data("participants"));
            });
        });
    </script>
}

</div>
