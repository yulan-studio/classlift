@model Core.ViewModels.OrganizationPaymentSettingsViewModel

<h4>Payment</h4>
<p class="text-muted">Configure the payment instructions shown for Direct payments.</p>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success" role="alert">@ViewBag.SuccessMessage</div>
}
<form asp-controller="Account" asp-action="PaymentSettings" method="post" class="settings-form" style="max-width: 720px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="DirectPaymentInstructionTemplate" class="form-label">Direct payment instructions</label>
        <textarea asp-for="DirectPaymentInstructionTemplate" class="form-control" rows="4" maxlength="2000"></textarea>
        <span asp-validation-for="DirectPaymentInstructionTemplate" class="text-danger"></span>
        <div class="form-text">Supported placeholders: <code>{amount}</code> and <code>{payment_scope}</code>.</div>
    </div>
    <button type="submit" class="btn btn-primary classlift-button">Save payment settings</button>
</form>
