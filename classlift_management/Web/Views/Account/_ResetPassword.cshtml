@model Core.ViewModels.ResetPasswordViewModel

<h4>Reset Password</h4>
<p class="text-muted">
    Locate an Admin, Staff, @CurrentTenant.Terminology.ParticipantSingular, or
    @CurrentTenant.Terminology.ProviderSingular account by its exact username.
</p>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<form class="settings-form"
      asp-controller="Account"
      asp-action="FindResetPasswordUser"
      method="post"
      style="max-width: 560px;">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="input-group">
        <input asp-for="SearchUsername" class="form-control" placeholder="Username" autocomplete="off" />
        <button type="submit" class="btn btn-primary">Locate User</button>
    </div>
    <span asp-validation-for="SearchUsername" class="text-danger"></span>
</form>

@if (Model.HasUserProfile)
{
    <div class="card mt-4" style="max-width: 560px;">
        <div class="card-header">User Profile</div>
        <div class="card-body">
            <dl class="row mb-3">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@(Model.DisplayName ?? "N/A")</dd>
                <dt class="col-sm-4">Username</dt>
                <dd class="col-sm-8">@Model.Username</dd>
                <dt class="col-sm-4">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>
                <dt class="col-sm-4">Role</dt>
                <dd class="col-sm-8">
                    @(Model.Role switch
                    {
                        "Child" => CurrentTenant.Terminology.ParticipantSingular,
                        "Coach" => CurrentTenant.Terminology.ProviderSingular,
                        _ => Model.Role
                    })
                </dd>
            </dl>

            <div class="alert alert-warning">
                This will immediately replace the user’s password with <strong>hello123!</strong>.
            </div>

            <form class="settings-form"
                  asp-controller="Account"
                  asp-action="ResetUserPassword"
                  method="post"
                  onsubmit="return confirm('Reset this user\'s password to hello123!?');">
                <input asp-for="TargetUserId" type="hidden" />
                <input asp-for="SearchUsername" type="hidden" />
                <button type="submit" class="btn btn-primary">Reset Password</button>
            </form>
        </div>
    </div>
}
