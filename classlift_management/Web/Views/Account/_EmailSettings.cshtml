@model Core.ViewModels.OrganizationEmailSettingsViewModel

<h4>Organization email</h4>
<p class="text-muted">
    Set the addresses ClassLift will use for your organization's email notifications.
</p>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success" role="alert">@ViewBag.SuccessMessage</div>
}

<form asp-controller="Account" asp-action="EmailSettings" method="post" class="settings-form" style="max-width: 560px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="SenderEmail" class="form-label"></label>
        <input asp-for="SenderEmail"
               class="form-control"
               type="email"
               inputmode="email"
               autocomplete="email"
               placeholder="no-reply@example.com" />
        <span asp-validation-for="SenderEmail" class="text-danger"></span>
        <div class="form-text">
            This address will appear in the From field. Your email provider must allow ClassLift to send from it.
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="ReceiverEmail" class="form-label"></label>
        <input asp-for="ReceiverEmail"
               class="form-control"
               type="email"
               inputmode="email"
               autocomplete="email"
               placeholder="notifications@example.com" />
        <span asp-validation-for="ReceiverEmail" class="text-danger"></span>
        <div class="form-text">
            Internal notifications for your organization will be sent to this address.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save email settings</button>
</form>
