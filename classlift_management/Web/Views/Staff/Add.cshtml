    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Staff";
}



<h2>Add Staff</h2>


<style>
    .add-form-table { border-collapse: collapse; width: 50%; max-width: 850px; text-align: left; }
    .add-form-table td { padding: 8px; }
    .add-form-table td:first-child { width: 180px; white-space: nowrap; vertical-align: top; }
    .add-form-table td:nth-child(2) input { width: 100%; max-width: 300px; min-height: 42px; box-sizing: border-box; }
    .add-form-table td[colspan="2"] { padding-top: 16px !important; }
    .add-form-table button, .add-form-table a { display: inline-block; min-height: 42px; box-sizing: border-box; padding: 10px 16px !important; }
    .password-row { display: flex; align-items: flex-start; gap: 12px; }
    .password-row input { flex: 0 0 300px; }
    .password-help { display: block; width: 402px; max-width: 402px; margin-top: 4px; }
    @@media (max-width: 767px) {
        .add-form-table, .add-form-table tbody, .add-form-table tr, .add-form-table td { display: block; width: 100%; }
        .add-form-table tr { margin-bottom: 12px; }
        .add-form-table td { padding: 4px 0 !important; }
        .add-form-table td:first-child { padding-bottom: 0 !important; }
        .add-form-table input { min-height: 42px; max-width: none !important; box-sizing: border-box; }
        .password-row { flex-direction: column; gap: 4px; }
        .password-row input { flex: none; width: 100% !important; }
        .password-help { width: 300px; max-width: 100%; }
    }
</style>

<form method="post" action="/Staff/Add">


    <table class="add-form-table">
    <tr>
        <td style="padding: 8px;"><label for="name">Name:</label></td>
        <td style="padding: 8px;"><input type="text" name="name" placeholder="Name" style="width: 100%;" /></td>
    </tr>
      
    <tr>
        <td style="padding: 8px;"><label for="email">Email:</label></td>
        <td style="padding: 8px;"><input type="email" name="email" placeholder="Email" style="width: 100%;" required /></td>
    </tr>
    <tr>
        <td style="padding: 8px;"><label for="phone">Phone:</label></td>
        <td style="padding: 8px;"><input type="text" name="phone" placeholder="Phone" style="width: 100%;" /></td>
    </tr>
    <tr>
        <td style="padding: 8px;"><label for="wechat">WeChat:</label></td>
        <td style="padding: 8px;"><input type="text" name="wechat" placeholder="WeChat" style="width: 100%;" /></td>
    </tr>
    <tr>
            <td style="padding: 8px; vertical-align:top"><label for="password">Password:</label></td>
        <td style="padding: 8px;"><div class="password-row"><input type="text"
                                         id="password"
                                         name="password"
                                         placeholder="Password"
                                         value="hello123!"
                                         pattern="(?=.*[a-z])(?=.*\d)(?=.*[^A-Za-z0-9]).{6,}"
                                         title="Password must be at least 6 characters long and include a lowercase letter, a digit, and a special character."
                                         oninvalid="this.setCustomValidity('Password must be at least 6 characters long and include a lowercase letter, a digit, and a special character.')"
                                         oninput="this.setCustomValidity('')"
                                         style="width: 100%;"
                                         required />
                <small class="password-help" style="color:darkslategray">Password must be at least 6 characters long and include a lowercase letter, a digit, and a special character. </small></div>
         </td>
    </tr>
    <tr>
            <td colspan="2" style="text-align: left;  padding: 20px 16px 16px 8px;">
            <button type="submit" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; cursor: pointer;">Add Staff</button>
                <a href="/Staff/List" style="background-color: #ddd; color: black; text-decoration: none; padding: 5px 10px; border: 1px solid #ccc;">Cancel</a>
        </td>
    </tr>
</table>


@if (!ViewData.ModelState.IsValid)
{
    foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
    {
        <div class="alert alert-danger">
            @error.ErrorMessage
        </div>
    }
}

</form>



