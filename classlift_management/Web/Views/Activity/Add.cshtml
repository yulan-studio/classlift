@*
    Activity Add Form - Follows the Staff Form Layout
*@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Activity";
}

<h2>Add Activity</h2>
<div style="padding-top: 20px;">
  
</div>

<form asp-action="Add" method="post">
    <table style="border-collapse: collapse; width: 80%; text-align: left; width:80%">
        <tr>
            <td style="padding: 8px; width: 20%"><label for="Title">Name:</label></td>
            <td style="padding: 8px; width: 80%"><input type="text" name="Title" placeholder="Activity Name" style="width: 70%;" required /></td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="Description">Description:</label></td>
            <td style="padding: 8px;">
                <textarea name="Description" placeholder="Enter activity description" style="width: 70%;" rows="3"></textarea>
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="Address">Address:</label></td>
            <td style="padding: 8px;"><input type="text" name="Address" placeholder="Activity Address" style="width: 70%;" /></td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="MaxCapacity">Max Capacity:</label></td>
            <td style="padding: 8px;"><input type="number" name="MaxCapacity" placeholder="Enter max participants" step="1" value="50" min="0" style="width: 25%;" /></td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="scheduledTimeZoneId">Event Time Zone:</label></td>
            <td style="padding: 8px;">
                <select id="scheduledTimeZoneId" name="scheduledTimeZoneId" required style="width: 45%;">
                    @foreach (var zone in (IReadOnlyList<TimeZoneOption>)ViewBag.TimeZones)
                    {
                        <option value="@zone.Id" selected="@(zone.Id == (string)ViewBag.SelectedTimeZoneId)">@zone.DisplayName (@zone.Id)</option>
                    }
                </select>
            </td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="ScheduledAt">Scheduled Date:</label></td>
            <td style="padding: 8px;"><input type="datetime-local" name="ScheduledAt" style="width: 25%;" required /></td>
        </tr>
        

     

        <tr>

            <td style="padding: 8px;"><label for="Status">Status:</label></td>
            <td style="padding: 8px;">
                <select name="status" style="width: 25%;" required>
                    <option value="" selected>-- Select Status --</option>
                    <option value="Open">Open to registration</option>
                    <option value="Closed">Closed to registration</option> 
                 
                </select>
            </td>
        </tr>
      
        <tr>
            <td colspan="2" style="text-align: left; padding: 20px 16px 16px 8px;">
                <button type="submit" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; cursor: pointer;">Add Activity</button>
                <a href="/Activity/List" style="background-color: #ddd; color: black; text-decoration: none; padding: 5px 10px; border: 1px solid #ccc;">Cancel</a>
            </td>
        </tr>

        <tr>
            <td colspan="2" style="text-align: left; padding: 20px 16px 16px 8px;">
                @if (!ViewData.ModelState.IsValid)
                {
                    foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div class="alert alert-danger">
                            @error.ErrorMessage
                        </div>
                    }
                }
            </td>
        </tr>
    </table>
</form>








