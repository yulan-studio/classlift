@model Core.ViewModels.ActivityRegistrationsViewModel

@{
    ViewData["Title"] = "Activity Registrations";
}

<h1 class="management-page-title">Activity Registrations</h1>
<p><strong>Activity:</strong> @Model.ActivityTitle</p>
<a asp-action="List" class="participation-back-link" style="color: #000 !important;">Back to Activities List</a>
<div style="border-top: 2px solid #ddd; margin: 20px 0;"></div>

<div class="management-table-wrapper"><table class="management-table">
    <thead class="table-primary">
        <tr><th>#</th><th>@CurrentTenant.Terminology.ParticipantSingular</th><th>Status</th></tr>
    </thead>
    <tbody>
        @if (Model.Students.Any())
        {
            for (var index = 0; index < Model.Students.Count; index++)
            {
                var student = Model.Students[index];
                <tr><td>@(index + 1)</td><td><a href="/Child/MoreInfo/@student.ChildID">@student.Name</a></td><td>@student.Status</td></tr>
            }
        }
        else
        {
            <tr><td colspan="3" class="text-center">No registered @CurrentTenant.Terminology.ParticipantPlural.ToLowerInvariant().</td></tr>
        }
    </tbody>
</table></div>
