@model PaymentPackage

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = Model.PackageID == 0 ? "Add Payment Package" : "Edit Payment Package";
}

<h2>@ViewData["Title"]</h2>

<style>
    .payment-package-form-table {
        border-collapse: collapse;
        width: 50%;
        max-width: 600px;
        text-align: left;
    }

    .payment-package-form-table td {
        padding: 8px;
    }

    .payment-package-form-table td:first-child {
        width: 180px;
        white-space: nowrap;
        vertical-align: top;
    }

    .payment-package-form-table input[type="text"],
    .payment-package-form-table input[type="number"],
    .payment-package-form-table textarea {
        width: 100%;
        max-width: 300px;
        min-height: 42px;
        box-sizing: border-box;
    }

    .payment-package-form-table textarea {
        min-height: 100px;
    }

    .payment-package-form-table td[colspan="2"] {
        padding-top: 16px !important;
    }

    .payment-package-form-table button,
    .payment-package-form-table a {
        display: inline-block;
        min-height: 42px;
        box-sizing: border-box;
        padding: 10px 16px !important;
    }

    @@media (max-width: 767px) {
        .payment-package-form-table,
        .payment-package-form-table tbody,
        .payment-package-form-table tr,
        .payment-package-form-table td {
            display: block;
            width: 100%;
        }

        .payment-package-form-table tr {
            margin-bottom: 12px;
        }

        .payment-package-form-table td {
            padding: 4px 0 !important;
        }

        .payment-package-form-table td:first-child {
            padding-bottom: 0 !important;
        }

        .payment-package-form-table input[type="text"],
        .payment-package-form-table input[type="number"],
        .payment-package-form-table textarea {
            max-width: none;
        }
    }
</style>

<form method="post" action="/PaymentPackage/Save">
    <input type="hidden" name="PackageID" value="@Model.PackageID" />

    <table class="payment-package-form-table">
        <tr>
            <td style="padding: 8px;"><label for="Title">Title:</label></td>
            <td style="padding: 8px;"><input type="text" name="Title" value="@Model.Title" required class="classlift-control" style="width: 100%;" /></td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="Description">Description:</label></td>
            <td style="padding: 8px;"><textarea name="Description" class="classlift-control" style="width: 100%;">@Model.Description</textarea></td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="Amount">Amount ($):</label></td>
            <td style="padding: 8px;"><input type="number" name="Amount" value="@Model.Amount" step="0.01" required class="classlift-control" style="width: 100%;" /></td>
        </tr>

        <tr>
            <td style="padding: 8px;"><label for="Active">Is Active:</label></td>
            <td style="padding: 8px;">
               @*  <input type="checkbox" name="Active" value="true" @(Model.Active ? "checked" : "") /> *@

            <input asp-for="IsActive" type="checkbox" class="classlift-checkbox" />
            <input type="hidden" asp-for="IsActive" value="false" />
            </td>
        </tr>

        <tr>
            <td colspan="2" style="text-align: left; padding: 16px;">
                <button type="submit" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; cursor: pointer;">
                    Save
                </button>
                <a href="/PaymentPackage/List" style="background-color: #ddd; color: black; text-decoration: none; padding: 5px 10px; border: 1px solid #ccc;">Cancel</a>
            </td>
        </tr>
    </table>
</form>
