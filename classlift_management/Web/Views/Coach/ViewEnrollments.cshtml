@model Core.ViewModels.ManageEnrollmentsViewModel

<style>
    .completed-note-actions { display: inline-flex; align-items: center; gap: .4rem; }
    .enrollment-page-help { margin: -0.75rem 0 1.25rem; max-width: 900px; color: #65748b; font-size: .95rem; line-height: 1.55; }
    .enrollment-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 2rem 0 .85rem; }
    .enrollment-section-heading h4 { margin: 0; color: #1b7bab; font-size: 1.35rem; font-weight: 700; }
    .enrollment-section-heading a { color: #1b7bab; font-weight: 600; }
    .enrollment-back-link { margin-top: 0; margin-bottom: 1rem; }
    .enrollment-info-panel { margin-top: 1.25rem; }

    table.mobile-stack {
        width: 100%;
        border-collapse: collapse;
    }

    table.mobile-stack th,
    table.mobile-stack td {
        border: 1px solid #ddd;
        padding: 8px;
        vertical-align: top;
    }

    @@media (max-width: 767px) {
        .desktop-only {
            display: none !important;
        }
    }
</style>

<h2 class="mb-4">View Enrollments</h2>

<p class="enrollment-page-help">
    Review completed sessions and manage @CurrentTenant.Terminology.ProviderSingular.ToLowerInvariant() notes.
</p>

<a href="/Coach/ManageCourse" class="participation-back-link enrollment-back-link">← Back to Courses List</a>



<div class="enrollment-info-panel p-3 mb-4 bg-light border rounded">
    <strong>Course:</strong> @Model.Course.Title@if (!string.IsNullOrWhiteSpace(Model.Course.Description)) {<text> | @Model.Course.Description</text>} <br />
    <strong>Session Count:</strong> @Model.Course.SessionCount <br />
    <strong>@CurrentTenant.Terminology.ParticipantSingular:</strong> @Model.Child.Name <br />
    @* <strong>Birthday:</strong> @(Model.Child.BirthDate?.ToShortDateString()) <br /> *@



</div>

<div class="enrollment-section-heading">
    <h4>Completed Sessions</h4>
    @if (Model.Course.CourseType == "Private" && Model.Course.SessionCount.HasValue)
    {
        <a href="/Coach/ManageSchedules/@Model.Child.ChildID?courseId=@Model.Course.CourseID&enrollmentId=@Model.EnrollmentID">Upcoming Sessions</a>
    }
</div>



<table class="management-table mobile-stack table table-bordered mt-3">
    <thead class="management-table-header">
        <tr>
            <th>Scheduled At</th>
            <th class="desktop-only">@CurrentTenant.Terminology.ParticipantSingular Note</th>
            <th>My Note</th>
            <th class="action-column">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CompletedEnrollments.Any())
        {
            foreach (var completed in Model.CompletedEnrollments)
            {
                <tr>
                    <td>@(completed.ScheduledAt.HasValue ? completed.ScheduledAt.Value.ToUserTime(User, AppTimeZoneService).ToString("yyyy-MM-dd") : "")</td>
                    <td class="desktop-only" data-label="@CurrentTenant.Terminology.ParticipantSingular Note">@completed.ParentNote</td>
                    <td data-label="My Note">
                        <span id="coach-note-view-@completed.EnrollmentID">@completed.CoachNote</span>
                        <textarea id="coach-note-edit-@completed.EnrollmentID" name="coachNote" form="coach-note-@completed.EnrollmentID" class="form-control" style="display: none;">@completed.CoachNote</textarea>
                    </td>
                    <td data-label="Action">
                        <form id="coach-note-@completed.EnrollmentID" method="post" action="/Coach/UpdateCoachNote">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="enrollmentId" value="@completed.EnrollmentID" />
                            <input type="hidden" name="childId" value="@Model.Child.ChildID" />
                            <input type="hidden" name="courseId" value="@Model.Course.CourseID" />
                            <input type="hidden" name="rootEnrollmentId" value="@Model.EnrollmentID" />
                            <span class="completed-note-actions">
                                <a id="coach-note-edit-link-@completed.EnrollmentID" href="javascript:void(0);" onclick="editCoachNote(@completed.EnrollmentID)">Update Note</a>
                                <button id="coach-note-save-@completed.EnrollmentID" type="submit" class="btn classlift-secondary-button" style="display: none;">Save</button>
                                <button id="coach-note-cancel-@completed.EnrollmentID" type="button" class="btn btn-secondary" style="display: none;" onclick="cancelCoachNote(@completed.EnrollmentID)">Cancel</button>
                            </span>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No completed sessions.</td>
            </tr>
        }
    </tbody>
</table>

<script>
    function editCoachNote(enrollmentId) {
        const noteView = document.getElementById(`coach-note-view-${enrollmentId}`);
        const noteEdit = document.getElementById(`coach-note-edit-${enrollmentId}`);
        const editLink = document.getElementById(`coach-note-edit-link-${enrollmentId}`);
        const saveButton = document.getElementById(`coach-note-save-${enrollmentId}`);

        noteView.style.display = 'none';
        noteEdit.style.display = 'block';
        editLink.style.display = 'none';
        saveButton.style.display = 'inline-block';
        document.getElementById(`coach-note-cancel-${enrollmentId}`).style.display = 'inline-block';
        noteEdit.focus();
    }

    function cancelCoachNote(enrollmentId) {
        const noteView = document.getElementById(`coach-note-view-${enrollmentId}`);
        const noteEdit = document.getElementById(`coach-note-edit-${enrollmentId}`);
        noteEdit.value = noteView.textContent;
        noteEdit.style.display = 'none';
        noteView.style.display = 'inline';
        document.getElementById(`coach-note-edit-link-${enrollmentId}`).style.display = 'inline';
        document.getElementById(`coach-note-save-${enrollmentId}`).style.display = 'none';
        document.getElementById(`coach-note-cancel-${enrollmentId}`).style.display = 'none';
    }
</script>
