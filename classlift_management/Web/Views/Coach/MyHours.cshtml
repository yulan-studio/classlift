<h4>Total Income: <strong>$@total.ToString("F2")</strong></h4> *@


<h2>My Hours</h2>

@if (ViewBag.HoursError != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.HoursError
    </div>
}


    @foreach (var month in Model)
    {
    <div style="margin: 20px 0; padding: 15px; border-radius: 5px; border: 1px solid #ddd; background-color: #fff;">
        <h4 style="color:#1B7BAB;">@month.Year - @month.Month</h4>

        
       

        <div class="monthly-summary">
            <span class="total-hours" style="background-color:#f9f9f9;">
                <strong>Total Hours:</strong> @month.TotalHours
            </span>

            <a href="#"
               class="text-decoration-none"
               onclick="toggleDetails('details-@month.Year-@month.Month'); return false;">
                Show / Hide Details
            </a>
        </div>

        

     

        <div id="details-@month.Year-@month.Month" class="hours-details-wrapper">
            <table class="hours-details-table">
                <colgroup>
                    <col style="width:20%;" />
                    <col style="width:25%;" />
                    <col style="width:35%;" />
                    <col style="width:20%;" />
                </colgroup>

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>@CurrentTenant.Terminology.ParticipantSingular</th>
                        <th>Course</th>
                        <th>Hours</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in month.Details)
                    {
                        <tr>
                            <td>@d.ScheduledAt.ToUserTime(User, AppTimeZoneService).ToShortDateString()</td>
                            <td>@d.ChildName</td>
                            <td>@d.CourseName</td>
                            <td>@d.Hours</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }

   


<script>
    function toggleDetails(id) {
        const el = document.getElementById(id);
        if (!el) return;

        el.style.display = (el.style.display === 'none') ? 'block' : 'none';
    }
</script>
