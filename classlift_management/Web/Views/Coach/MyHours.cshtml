@* @model List<Core.ViewModels.HoursViewModel> *@
@model List<Core.DTOs.CoachMonthlyIncome>
@{
    ViewData["Title"] = "Coach Hours";
    //decimal total = ViewBag.TotalIncome;
}

<style>
    .monthly-summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 10px;
    }

    .hours-details-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .hours-details-table {
        width: 100%;
        min-width: 520px;
        table-layout: fixed;
    }

    @@media (max-width: 767px) {
        .monthly-summary {
            display: block;
        }

        .monthly-summary .total-hours {
            display: block;
            width: 100%;
            margin-bottom: 8px;
            padding: 8px;
        }

        .monthly-summary a {
            display: inline-block;
            padding: 6px 0;
        }
    }
</style>

@* <h2>Coach Income</h2>

