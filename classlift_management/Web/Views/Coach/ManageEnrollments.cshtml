@model Core.ViewModels.ManageEnrollmentsViewModel

<style>


    /* .btn-primary {
        background-color: #1B7BAB;
        border: 1px solid #1B7BAB;
    }

    .btn-primary:hover,
    .btn-primary:focus,
    .btn-primary:active,
    .btn-primary.active {
        background-color: #23A1E0 !important;
        border-color: #23A1E0 !important;
        box-shadow: none !important;
    } */

    /* Desktop default */
    table.mobile-stack {
        width: 100%;
        border-collapse: collapse;
    }

    table.mobile-stack th,
    table.mobile-stack td {
        border: 1px solid #ddd;
        padding: 8px;
        vertical-align: top;
    }

    .row-same {
        margin-right:10px;
        margin-bottom: 10px;
    }

    /* Desktop: ActualHours + CoachNote on same line */
    .row-fields {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: nowrap;
    }

    .input-hours {
        width: 60px;
        margin-right: 10px;
        margin-bottom: 15px;
    }

   

    .input-note {
       /*  width: 200px;
        resize: none;
        height: 38px;  */
        /* same as Bootstrap input */
       /*  line-height: 1.5; */
        /* overflow-y: hidden; */
       /*  margin-bottom: 10px; */
        width: 90%;
        height: auto;
        min-height: 80px;
        margin-bottom: 15px;
    }

    /* Mobile: keep table, improve form */

    @@media (max-width: 767px) {

        .desktop-only {
            display: none !important;
        }

        .complete-form

        {
            display: block;
        }

        .row-same {
            margin-bottom: 10px;
        }

        .row-fields {
            flex-direction: column;
            align-items: stretch;
        }

        #scheduleTable.mobile-stack {
            display: block;
            border: 0;
        }

        #scheduleTable.mobile-stack thead {
            display: none;
        }

        #scheduleTable.mobile-stack tbody,
        #scheduleTable.mobile-stack tr,
        #scheduleTable.mobile-stack td {
            display: block;
            width: 100%;
        }

        #scheduleTable.mobile-stack tr {
            margin-bottom: 16px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fff;
        }

        #scheduleTable.mobile-stack td {
            border: 0;
            padding: 6px 0;
        }

        #scheduleTable.mobile-stack td::before {
            content: attr(data-label);
            display: block;
            margin-bottom: 3px;
            color: #1B7BAB;
            font-weight: 600;
        }

        #scheduleTable .row-button .btn {
            width: 100%;
            min-height: 44px;
        }
       /*  .row-fields {
            display: flex;
            gap: 8px;
        } */

        .row-same {
            margin-bottom: 10px;
        }

        .input-hours {
            width: 60px;
            margin-bottom: 10px;
        }

        

        .input-note {
            width: 100%;
            height: 160px !important;
            min-height: 160px !important;
            resize: vertical;
            margin-bottom: 10px;
        }

        input::placeholder {
            font-size: 12px;
        }
       

    }
   
</style>

<h2 class="mb-4">Manage Enrollments</h2>


<a href="/Coach/ManageCourse" class="participation-back-link">← Back to Courses List</a>

<div style="margin: 30px 0; padding: 20px; background-color: #f2f2f2">
    <p><strong>Course:</strong> @Model.Course.Title</p>
    <p><strong>@CurrentTenant.Terminology.ParticipantSingular:</strong> @Model.Child.Name</p>
    @if(Model.Course.SessionCount!= null )
    {
        <p><strong>Session Count:</strong> @Model.Course.SessionCount</p>
    }

</div>


<div style="margin: 0; padding: 30px 0; color: #1B7BAB;"><h5>Sessions Awaiting Completion</h5></div>

<div style="padding: 10px 10px 10px 10px; margin: 0px 0px 20px 0px; border: 1px solid #ddd; background-color: #FFDBF6; ">
    To complete the session, the @CurrentTenant.Terminology.ProviderSingular.ToLowerInvariant() is required to enter the actual hours and then click the 'Complete' button.
</div>

<div class="table-responsive">
    <table id="scheduleTable" class="mobile-stack table table-bordered mt-3"  style="border-collapse: collapse;">
        <thead class="table-primary">
            <tr>

                <th>Scheduled At</th>
                <th>Scheduled Hours</th>
                <th>Actual Hours</th>
            
            </tr>
        </thead>
        <tbody>
            @if (Model.WaitToCompleteEnrollments.Any())
            {
                foreach (var schedule in Model.WaitToCompleteEnrollments)
                {
                    <tr>

                        <td data-label="Scheduled At">@((schedule.ScheduledAt.HasValue) ? schedule.ScheduledAt.Value.ToUserTime(User, AppTimeZoneService).ToString("yyyy-MM-dd HH:mm") : "")</td>
                        <td data-label="Scheduled Hours">@schedule.ScheduledHours</td>
                        <td data-label="Actual Hours">


                            <form method="post" action="/Coach/CompleteSession" class="complete-form">
                                <input type="hidden" name="enrollmentId" value="@schedule.EnrollmentID" />
                                <input type="hidden" name="childId" value="@Model.Child.ChildID" />
                                <input type="hidden" name="courseId" value="@Model.Course.CourseID" />
                                <!-- Checkbox to show/hide fields -->
                                <!-- Checkbox for "Same as Schedule" -->
                                <div class="row-same">
                                    <label>
                                        <input type="checkbox" id="sameAsSchedule_@schedule.EnrollmentID"
                                               onchange="toggleFields('@schedule.EnrollmentID', this.checked);" checked />
                                        Same as Schedule
                                    </label>
                               </div>
                                
                                <!-- Fields to show/hide -->

                                <div id="extraFields_@schedule.EnrollmentID"
                                     class="row-fields"
                                     style="display:none; margin-top:10px;">

                                    <input name="actualHours"
                                           value="@schedule.ActualHours"
                                           type="number"
                                           step="0.25"
                                           min="0"
                                           style="width:50px"
                                           class="input-hours" />

                                    @* <input name="coachNote"
                                           value="@schedule.CoachNote"
                                           type="text"
                                           placeholder="Please enter notes if the hours are different."
                                           class="input-note" /> *@

                                    <textarea name="coachNote"
                                      class="input-note form-control"
                                      placeholder="Please enter notes if the hours are different.">@schedule.CoachNote</textarea>
                                     
                                    

                                </div>


                                @* <div id="extraFields_@schedule.EnrollmentID" class="row-fields" style="display: none; margin-top: 5px;">
                                    <input name="actualHours" value="@schedule.ActualHours" type="number" step="0.25" min="0"  style="width:60px" /> &nbsp;&nbsp;
                                    <input name="coachNote" value="@schedule.CoachNote" type="text" placeholder="Please enter notes if the hours are different." style="width: 360px" /> &nbsp;&nbsp;
                                </div> *@

                                <div class="row-button">
                                    <button type="submit" class="btn btn-primary">
                                        Complete
                                    </button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" style="text-align: center; padding: 10px;">No scheduled sessions to complete.</td>
                </tr>
            }

        </tbody>
    </table>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["ErrorMessage"]</div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning mt-3">@TempData["WarningMessage"]</div>
}

<div style="padding-top: 30px"></div>



<div style="margin: 0; padding: 30px 0; color: #1B7BAB; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
    <h5 style="margin: 0;">Completed Sessions</h5>
    @if (Model.Course.CourseType == "Private")
    {
        <a href="/Coach/ManageSchedules/@Model.Child.ChildID?courseId=@Model.Course.CourseID&enrollmentId=@Model.EnrollmentID">Upcoming Sessions</a>
    }
</div>


<table id="completeTable" class="mobile-stack table table-bordered mt-3" >
    <thead class="table-primary">
        <tr>

            <th>Scheduled At</th>
            <th>Scheduled Hours</th>
            <th>Actual Hours</th>
            <th class="desktop-only">@CurrentTenant.Terminology.ParticipantSingular Note</th>
            <th>@CurrentTenant.Terminology.ProviderSingular Note</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.CompletedEnrollments.Any())
        {
            foreach (var complete in Model.CompletedEnrollments)
            {
                <tr>

                    <td data-label="Scheduled At">@((complete.ScheduledAt.HasValue) ? complete.ScheduledAt.Value.ToUserTime(User, AppTimeZoneService).ToString("yyyy-MM-dd") : "")</td>
                    <td data-label="Scheduled Hours">@complete.ScheduledHours</td>
                    <td data-label="Actual Hours">@complete.ActualHours</td>
                    <td class="desktop-only" data-label="@CurrentTenant.Terminology.ParticipantSingular Note">@complete.ParentNote</td>
                    <td data-label="@($"{CurrentTenant.Terminology.ProviderSingular} Note")">
                        <span id="coach-note-view-@complete.EnrollmentID">@complete.CoachNote</span>
                        <textarea id="coach-note-edit-@complete.EnrollmentID" name="coachNote" form="coach-note-@complete.EnrollmentID" class="form-control" style="display: none;">@complete.CoachNote</textarea>
                    </td>
                    <td data-label="Action">
                        <form id="coach-note-@complete.EnrollmentID" method="post" action="/Coach/UpdateCoachNote">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="enrollmentId" value="@complete.EnrollmentID" />
                            <input type="hidden" name="childId" value="@Model.Child.ChildID" />
                            <input type="hidden" name="courseId" value="@Model.Course.CourseID" />
                            <input type="hidden" name="rootEnrollmentId" value="@Model.EnrollmentID" />
                            <input type="hidden" name="returnToManageEnrollments" value="true" />
                            <a id="coach-note-edit-link-@complete.EnrollmentID" href="javascript:void(0);" onclick="editCoachNote(@complete.EnrollmentID)">Edit</a>
                            <button id="coach-note-save-@complete.EnrollmentID" type="submit" class="btn classlift-secondary-button" style="display: none;">Save</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" style="text-align: center; padding: 10px;">No completed sessions.</td>
            </tr>
        }

        
    </tbody>
</table>

@if (TempData["CompletedSuccessMessage"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["CompletedSuccessMessage"]
    </div>
}

@if (TempData["CompletedErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["CompletedErrorMessage"]
    </div>
}




<script>
    function editCoachNote(enrollmentId) {
        document.getElementById('coach-note-view-' + enrollmentId).style.display = 'none';
        document.getElementById('coach-note-edit-' + enrollmentId).style.display = 'block';
        document.getElementById('coach-note-edit-link-' + enrollmentId).style.display = 'none';
        document.getElementById('coach-note-save-' + enrollmentId).style.display = 'inline-block';
    }

        function toggleFields(id, isChecked) {
        const fieldsDiv = document.getElementById('extraFields_' + id);
        // If "Same as Schedule" is checked, hide fields; otherwise show
        fieldsDiv.style.display = isChecked ? 'none' : 'inline';
    }
</script>
