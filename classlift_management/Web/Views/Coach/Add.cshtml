    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Coach";
}



<h2>Add @CurrentTenant.Terminology.ProviderSingular</h2>
<div style="padding-top: 20px;">
  
</div>

<style>
    .add-form-table { border-collapse: collapse; width: 100%; max-width: 850px; text-align: left; }
    .add-form-table { display: table; }
    .add-form-table tbody { display: table-row-group; }
    .add-form-table tr { display: table-row; }
    .add-form-table td { display: table-cell; }
    .add-form-table td:first-child { width: 25%; }
    .add-form-table td:nth-child(2) { width: 75%; }
    .add-form-table input, .add-form-table select { width: 100%; max-width: 300px; min-height: 42px; box-sizing: border-box; }
    .add-form-table select[multiple] { min-height: 100px; }
    .add-form-table td[colspan="2"] { padding-top: 16px !important; }
    .add-form-table button, .add-form-table a { display: inline-block; min-height: 42px; box-sizing: border-box; padding: 10px 16px !important; }
    .password-row { display: flex; align-items: flex-start; gap: 12px; }
    .password-row input { flex: 0 0 300px; }
    .password-help { display: block; width: 402px; max-width: 402px; margin-top: 4px; }

    @@media (max-width: 767px) {
        .add-form-table,
        .add-form-table tbody,
        .add-form-table tr,
        .add-form-table td {
            display: block;
            width: 100%;
        }

        .add-form-table tr { margin-bottom: 12px; }
        .add-form-table td { padding: 4px 0 !important; }
        .add-form-table td:first-child { padding-bottom: 0 !important; }

        .add-form-table input, .add-form-table select { max-width: none !important; }
        .password-row { flex-direction: column; gap: 4px; }
        .password-row input { flex: none; width: 100% !important; }
        .password-help { width: 300px; max-width: 100%; }
    }
</style>

    <form method="post" action="/Coach/Add">
    

    <table class="add-form-table">
        <tr>
            <td style="padding: 8px;"><label for="name">Name:</label></td>
            <td style="padding: 8px;"><input type="text" name="name" placeholder="Name" style="width: 100%;" required/></td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="gender">Gender:</label></td>
            <td style="padding: 8px;">
                <select name="gender" class="form-control" style="width: 100%;" required>
                    <option value="" selected>-- Select Gender --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="N/A">N/A</option>
                </select>
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="specialtyId">Specialty:</label></td>
            <td style="padding: 8px;">
              @*   <select name="specialtyId" class="form-control" style="width: 100%;">
                    <option value="" selected>-- Select Specialty --</option>
                    @foreach (var specialty in ViewBag.SpecialtyList)
                    {
                        <option value="@specialty.Value">@specialty.Text</option>
                    }
                </select> *@
                <select name="specialtyIds" multiple class="form-control" style="width: 100%;" required>
                   @*  <option value="" selected>-- Select Specialties --</option> *@
                    @foreach (var specialty in ViewBag.SpecialtyList)
                    {
                        <option value="@specialty.Value">@specialty.Text</option>
                    }
                </select>
                <small style="color: darkslategray;">You can hold CTRL to select multiple specialties</small>
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="provinceId">Province:</label></td>
            <td style="padding: 8px;">
                <select name="provinceId" id="provinceId" class="form-control" style="width: 100%;" required>
                    <option value="">-- Select Province --</option>
                    @foreach (var province in ViewBag.ProvinceList)
                    {
                        <option value="@province.Value" selected="@(province.Selected ? "selected" : null)">@province.Text</option>
                    }
                </select>
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="cityId">City:</label></td>
            <td style="padding: 8px;">
                <select name="cityId" id="cityId" class="form-control" style="width: 100%;" required @(ViewBag.CityList.Count == 0 ? "disabled" : null)>
                    <option value="">-- Select City --</option>
                    @foreach (var city in ViewBag.CityList)
                    {
                        <option value="@city.Value" selected="@(city.Selected ? "selected" : null)">@city.Text</option>
                    }
                </select>
                <small id="cityHelp" style="display: block; color: darkslategray;">Select a province first.</small>
            </td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="email">Email:</label></td>
            <td style="padding: 8px;"><input type="email" name="email" placeholder="Email" style="width: 100%;" /></td>
        </tr>
        <tr>
            <td style="padding: 8px;"><label for="phone">Phone:</label></td>
            <td style="padding: 8px;"><input type="text" name="phone" placeholder="Phone" style="width: 100%;" /></td>
        </tr>
        <tr>
            <td style="padding: 8px; vertical-align:top"><label for="password">Password:</label></td>
            <td style="padding: 8px;">
                <div class="password-row">
                <input type="text" name="password" placeholder="Password" value="hello123!" style="width: 100%;" />
                <small class="password-help" style="color:darkslategray">Password must be at least 6 characters long and include a lowercase letter, a digit, and a special character. </small>
                </div>
            </td>
        </tr>
        <tr>
            <td colspan="2" style="text-align: left;  padding: 20px 16px 16px 8px;">
                <button type="submit" style="background-color: #ff4d4d; color: white; border: none; padding: 5px 10px; cursor: pointer;">Add @CurrentTenant.Terminology.ProviderSingular</button>
                <a href="/Coach/List" style="background-color: #ddd; color: black; text-decoration: none; padding: 5px 10px; border: 1px solid #ccc;">Cancel</a>

            </td>
        </tr>
    </table>

    @if (!ViewData.ModelState.IsValid)
    {
        foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div class="alert alert-danger">
                @error.ErrorMessage
            </div>
        }
    }

    </form>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const provinceSelect = document.getElementById("provinceId");
        const citySelect = document.getElementById("cityId");
        const cityHelp = document.getElementById("cityHelp");

        function updateCityHelp() {
            cityHelp.textContent = provinceSelect.value ? "Select a city." : "Select a province first.";
            cityHelp.style.display = citySelect.value ? "none" : "block";
        }

        citySelect.addEventListener("change", updateCityHelp);
        provinceSelect.addEventListener("change", async function () {
            citySelect.innerHTML = '<option value="">-- Select City --</option>';
            citySelect.disabled = true;

            if (!provinceSelect.value) {
                updateCityHelp();
                return;
            }

            cityHelp.style.display = "block";
            cityHelp.textContent = "Loading cities...";
            try {
                const response = await fetch(`/Coach/CitiesByProvince/${provinceSelect.value}`);
                if (!response.ok) throw new Error();
                const cities = await response.json();
                cities.forEach(function (city) {
                    const option = document.createElement("option");
                    option.value = city.value;
                    option.textContent = city.text;
                    citySelect.appendChild(option);
                });
                citySelect.disabled = cities.length === 0;
                cityHelp.textContent = cities.length ? "Select a city." : "No cities are configured for this province.";
            } catch {
                cityHelp.textContent = "Cities could not be loaded. Please try again.";
            }
        });

        updateCityHelp();
    });
</script>


