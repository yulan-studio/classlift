@{
    ViewData["Title"] = "Excel Import";
    var importType = ViewBag.ImportType as string ?? "All";
    var importLabel = importType == "Coach" ? CurrentTenant.Terminology.ProviderSingular : CurrentTenant.Terminology.ParticipantSingular;
}
<style>
    .excel-import-page { font-family: Arial, sans-serif; color: #333; width: 100%; }
    .excel-import-page .import-section { width: 100%; box-sizing: border-box; margin: 22px 0 28px; padding: 20px 24px; background: #eef8fc; border: 1px solid #c7e8f3; border-radius: 6px; }
    .excel-import-page h4 { margin: 0 0 10px; font-size: 1.15rem; font-weight: 600; }
    .excel-import-page p { font-size: .95rem; line-height: 1.5; }
    .excel-import-page .import-description { margin-bottom: 1rem; color: #6c757d; font-size: 1rem; font-weight: 400; line-height: 1.5; }
    .excel-import-page .preview-summary p { margin: 2px 0; font-size: .82rem; line-height: 1.25; }
    .excel-import-page .template-fields { color: #8b0000; font-size: .85rem; }
    .excel-import-page code { font-family: inherit; font-size: inherit; color: inherit; }
    .excel-import-page input[type=file] { min-height: 38px; padding: 6px 6px 6px 0; font-size: .95rem; }
    .excel-import-page input[type=file]::file-selector-button { height: 32px; margin-left: 0; margin-right: 10px; padding: 5px 12px; color: #fff; background-color: var(--classlift-blue, #1b7bab); border: 1px solid var(--classlift-blue, #1b7bab); border-radius: 5px; cursor: pointer; }
    .excel-import-page input[type=file]::file-selector-button:hover { background-color: var(--classlift-blue-dark, #155a78); }
    .excel-import-page button.classlift-button { display: inline-flex; align-items: center; justify-content: center; min-width: 190px; width: auto; height: 40px !important; min-height: 40px !important; padding: 8px 14px !important; line-height: 1.25 !important; font-size: .95rem; vertical-align: middle; color: #fff !important; background-color: var(--classlift-blue, #1b7bab) !important; border: 1px solid var(--classlift-blue, #1b7bab) !important; }
    .excel-import-page .classlift-button.cancel-button { color: #000 !important; background-color: #ddd !important; border-color: #ccc !important; }
</style>
<div class="excel-import-page">
    <h1 class="management-page-title">@importLabel Excel Import</h1>
    <p class="import-description">Upload an .xlsx file using the approved @importLabel template. Blank or unknown cities are assigned to Unknown. Password is automatically set to <code>hello123!</code>.</p>
    @if (ViewBag.Preview == true)
    {
        <section class="import-section preview-summary">
            <h4>Import preview</h4>
            <p>Total rows: @ViewBag.TotalRows</p>
            <p>Existing Email addresses: @ViewBag.ExistingEmails</p>
            <p>Duplicate Email addresses in this file: @ViewBag.DuplicateEmails</p>
            <p>Warnings: @ViewBag.Warnings</p>
            <p>Errors: @ViewBag.Errors</p>
            <form asp-action="Confirm" method="post" style="display:inline">@Html.AntiForgeryToken()<button type="submit" class="classlift-button">Confirm import</button></form>
            <form asp-action="Cancel" method="post" style="display:inline;margin-left:8px">@Html.AntiForgeryToken()<button type="submit" class="classlift-button cancel-button">Cancel</button></form>
        </section>
    }
    @if (importType == "Coach")
    {
        <section class="import-section"><h4>@CurrentTenant.Terminology.ProviderSingular</h4><p class="template-fields"><code>Name, Email, Gender, Phone, Province, City, Specialty</code> (Specialty is optional; separate multiple specialties with commas.)</p><p><a href="/User/ExcelImport/Template/Coach">Download template</a></p><form action="/Coach/Import/Preview" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="file" name="file" accept=".xlsx" required /><button type="submit" class="classlift-button">Preview @CurrentTenant.Terminology.ProviderPlural</button></form></section>
    }
    @if (importType == "Child")
    {
        <section class="import-section"><h4>@CurrentTenant.Terminology.ParticipantSingular</h4><p class="template-fields"><code>Name, Email, BirthDate, Gender, Province, City</code></p><p><a href="/User/ExcelImport/Template/Child">Download template</a></p><form action="/Child/Import/Preview" method="post" enctype="multipart/form-data">@Html.AntiForgeryToken()<input type="file" name="file" accept=".xlsx" required /><button type="submit" class="classlift-button">Preview @CurrentTenant.Terminology.ParticipantPlural</button></form></section>
    }
</div>
