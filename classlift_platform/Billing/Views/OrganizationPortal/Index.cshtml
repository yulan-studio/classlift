@model Billing.ViewModels.OrganizationPortalViewModel
@{
    ViewData["Title"] = "Organization Billing";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Organization.OrganizationName</h1>
        <p class="text-muted mb-0">Billing and subscription</p>
    </div>
    <span class="badge @(Model.Organization.IsActive == true ? "bg-success" : "bg-secondary")">
        @(Model.Organization.IsActive == true ? "Active" : "Inactive")
    </span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card card-body"><small class="text-muted">Plan</small><strong>@(Model.CurrentSubscription?.Plan?.PlanName ?? "No active plan")</strong></div></div>
    <div class="col-md-4"><div class="card card-body"><small class="text-muted">Unpaid invoices</small><strong>@Model.Invoices.Count(i => i.InvoiceStatus != "Paid" && i.InvoiceStatus != "Cancelled")</strong></div></div>
    <div class="col-md-4"><div class="card card-body"><small class="text-muted">Successful payments</small><strong>@Model.SuccessfulPayments.ToString("C")</strong></div></div>
</div>

<div class="card">
    <div class="card-header"><h2 class="h5 mb-0">Invoices</h2></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Period</th><th>Due</th><th>Total</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var invoice in Model.Invoices)
            {
                <tr>
                    <td>@invoice.BillingPeriodStart.ToString("yyyy-MM-dd") – @invoice.BillingPeriodEnd.ToString("yyyy-MM-dd")</td>
                    <td>@invoice.DueDate.ToString("yyyy-MM-dd")</td>
                    <td>@invoice.TotalAmount.ToString("C")</td>
                    <td><span class="badge bg-light text-dark">@invoice.InvoiceStatus</span></td>
                    <td><a asp-action="Invoice" asp-route-id="@invoice.InvoiceId">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
