@model Billing.ViewModels.OrganizationPlanViewModel
@{
    ViewData["Title"] = "Change Plan";
}
<h1>Change Plan</h1>
<p class="text-muted">Coach count: <strong>@Model.CoachCount</strong></p>
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (Model.CurrentSubscription != null)
{
    <div class="alert alert-info">Current Plan: <strong>@Model.CurrentSubscription.Plan.PlanName</strong></div>
}
@if (Model.PendingChange != null)
{
    <div class="alert alert-warning">
        A payment is pending for <strong>@Model.PendingChange.RequestedPlan.PlanName</strong>.
        Please complete that payment before creating another Plan change.
    </div>
}
<div class="row g-3">
@foreach (var plan in Model.Plans)
{
    var total = plan.PricePerCoach * Model.CoachCount;
    <div class="col-md-4">
        <div class="card h-100"><div class="card-body">
            <h2 class="h5">@plan.PlanName</h2>
            <p>@plan.Description</p>
            <p><strong>@total.ToString("C") / month</strong></p>
            @if (Model.PendingChange == null && Model.CurrentSubscription?.PlanId != plan.PlanId)
            {
                <form asp-action="PlanCheckout" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="planId" value="@plan.PlanId" />
                    <button class="btn btn-primary">Continue to payment</button>
                </form>
            }
            else if (Model.CurrentSubscription?.PlanId == plan.PlanId)
            {
                <span class="badge text-bg-success">Current Plan</span>
            }
        </div></div>
    </div>
}
</div>
