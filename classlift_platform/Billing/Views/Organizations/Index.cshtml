@model Billing.ViewModels.OrganizationsIndexViewModel

@{
    ViewData["Title"] = "Organizations";
}

<div class="container mt-4">
    <h2>Organizations</h2>
    <a class="btn btn-success mb-3" href="/Organizations/Create">Create Organization</a>

    <table class="table table-bordered table-striped mt-3">
        <thead><tr><th>Name</th><th>Contact</th><th>Email</th><th>Current Plan</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var org in Model.Organizations)
            {
                <tr>
                    <td>@org.OrganizationName</td><td>@org.ContactName</td><td>@org.ContactEmail</td>
                    <td>@org.CurrentPlan?.PlanName</td><td>@org.OrganizationSubscriptions.FirstOrDefault()?.Status</td>
                    <td><a class="btn btn-sm btn-primary" href="/Organizations/Details/@org.OrganizationId">Details</a></td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="mt-5">Cancelled Registrations</h3>
    <p class="text-muted">Inactive organizations with cancelled subscriptions. Deletion permanently removes their tenant database and platform records.</p>

    @if (Model.CancelledRegistrations.Any())
    {
        <form asp-controller="Organizations" asp-action="BulkDelete" method="post"
              onsubmit="return confirm('Delete the selected organizations, tenant databases, subscriptions, invoices, payments, and events permanently?');">
            @Html.AntiForgeryToken()
            <table class="table table-bordered table-striped">
                <thead><tr><th><input type="checkbox" onclick="document.querySelectorAll('.cancelled-registration').forEach(x => x.checked = this.checked);" /></th><th>Name</th><th>Contact Email</th><th>Latest Subscription</th><th></th></tr></thead>
                <tbody>
                    @foreach (var org in Model.CancelledRegistrations)
                    {
                        <tr>
                            <td><input class="cancelled-registration" type="checkbox" name="organizationIds" value="@org.OrganizationId" /></td>
                            <td>@org.OrganizationName</td><td>@org.ContactEmail</td>
                            <td>@org.OrganizationSubscriptions.FirstOrDefault()?.Status</td>
                            <td><a class="btn btn-sm btn-outline-primary" href="/Organizations/Details/@org.OrganizationId">Details</a></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="submit" class="btn btn-danger">Delete Selected</button>
        </form>
    }
    else
    {
        <p>No cancelled registrations found.</p>
    }
</div>
