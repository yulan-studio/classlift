<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ClassLift Billing</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">

            <a class="navbar-brand"
               href="/Dashboard">
                ClassLift Billing
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <ul class="navbar-nav billing-nav">

                    @if (User.IsInRole("Admin"))
                    {

                    <li class="nav-item">
                        <a class="nav-link"
                           href="/Dashboard">
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Organization
                        </a>
                        <ul class="dropdown-menu">
                            <li><h6 class="dropdown-header">Organization management</h6></li>
                            <li><a class="dropdown-item" href="/Plans">Plans</a></li>
                            <li><a class="dropdown-item" href="/Organizations">Organizations</a></li>
                            <li><a class="dropdown-item" href="/FeatureAccessAdmin">Feature Access</a></li>
                            <li><a class="dropdown-item" href="/OrganizationAdmins">Organization Admins</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Billing
                        </a>
                        <ul class="dropdown-menu">
                            <li><h6 class="dropdown-header">Billing operations</h6></li>
                            <li><a class="dropdown-item" href="/Invoices">Invoices</a></li>
                            <li><a class="dropdown-item" href="/Payments">Payments</a></li>
                            <li><a class="dropdown-item" href="/SubscriptionEvents">Subscription Events</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="/Billing">Billing Job</a></li>
                            <li><a class="dropdown-item" href="/BillingRuns">Billing Run</a></li>
                        </ul>
                    </li>

                    }

                    @if (User.IsInRole("OrganizationAdmin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/organization">My Organization Billing</a>
                        </li>
                    }

                </ul>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="nav-link btn btn-link">
                                    Log out
                                </button>
                            </form>
                        </li>
                    </ul>
                }

            </div>
        </div>
    </nav>

    <div class="container-fluid mt-3">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @RenderBody()

    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container py-3">
            &copy; @DateTime.UtcNow.Year - ClassLift Billing Engine
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
